DEFAULT_CONFIG = REPO_ROOT / "config" / "lab.json"
SERVICE_LABEL = "com.erik.ai-systems-lab"
LEGACY_SERVICE_LABEL = "com.erik.local-ai-lab"
SERVICE_STATE_DIR = Path.home() / "Library" / "Application Support" / SERVICE_LABEL
LEGACY_SERVICE_STATE_PATH = (
    Path.home() / "Library" / "Application Support" / LEGACY_SERVICE_LABEL / "state.json"
)
SERVICE_STATE_PATH = SERVICE_STATE_DIR / "state.json"
LAUNCH_AGENT_PATH = Path.home() / "Library" / "LaunchAgents" / f"{SERVICE_LABEL}.plist"
LEGACY_LAUNCH_AGENT_PATH = (
    Path.home() / "Library" / "LaunchAgents" / f"{LEGACY_SERVICE_LABEL}.plist"
)
_LEGACY_MODELS_WARNINGS = set()
DEFAULT_SERVICE_STATE = {
    "auto_idle_enabled": True,
    "auto_idle_seconds": 900,
    "manual_unloaded": False,
    "mode": "cline",
    "pinned_model": None,
}


class LabError(Exception):
    pass


class LabHttpError(LabError):
    def __init__(self, method, url, status, body):
        self.method = method
        self.url = url
        self.status = status
        self.body = redact_secrets(body)
        message = redact_secrets(http_error_message(body) or body.strip() or "no response body")
        super().__init__(f"{method} {url} failed with HTTP {status}: {message}")


def redact_secrets(text):
    if not isinstance(text, str):
        return text
    return re.sub(r"sk-[A-Za-z0-9_*.-]{8,}", "sk-REDACTED", text)


def http_error_message(body):
    try:
        data = json.loads(body)
    except (TypeError, json.JSONDecodeError):
        return None
    error = data.get("error")
    if isinstance(error, dict):
        return error.get("message") or error.get("type")
    if isinstance(error, str):
        return error
    return data.get("message")


def now_stamp():
    return dt.datetime.now().strftime("%Y%m%d-%H%M%S")


def deep_merge(base, overlay):
    merged = copy.deepcopy(base)
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = copy.deepcopy(value)
    return merged


def project_env(suffix):
    return os.environ.get(f"AI_SYSTEMS_LAB_{suffix}") or os.environ.get(
        f"LOCAL_AI_LAB_{suffix}"
    )


def load_config(path):
    config_path = Path(path).expanduser().resolve()
    with open(config_path, "r", encoding="utf-8") as handle:
        cfg = json.load(handle)
    configured_overlay = project_env("LOCAL_CONFIG")
    local_config_path = (
        Path(configured_overlay).expanduser().resolve()
        if configured_overlay
        else config_path.with_name("lab.local.json")
    )
    if local_config_path.exists():
        with open(local_config_path, "r", encoding="utf-8") as handle:
            overlay = json.load(handle)
        cfg = deep_merge(cfg, overlay)
        cfg["_local_config_path"] = str(local_config_path)
    cfg["_config_path"] = str(config_path)
    return cfg


def service_state_path():
    override = project_env("STATE_PATH")
    return Path(override).expanduser().resolve() if override else SERVICE_STATE_PATH


def load_service_state():
    state = dict(DEFAULT_SERVICE_STATE)
    path = service_state_path()
    read_path = path
    if path == SERVICE_STATE_PATH and not path.exists() and LEGACY_SERVICE_STATE_PATH.exists():
        read_path = LEGACY_SERVICE_STATE_PATH
    if read_path.exists():
        try:
            stored = json.loads(read_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise LabError(f"Invalid service state at {read_path}: {exc}") from exc
        if not isinstance(stored, dict):
            raise LabError(f"Invalid service state at {read_path}: expected a JSON object")
        state.update({key: stored[key] for key in DEFAULT_SERVICE_STATE if key in stored})
    state["auto_idle_enabled"] = bool(state["auto_idle_enabled"])
    state["manual_unloaded"] = bool(state["manual_unloaded"])
    if state["mode"] not in {"cline", "benchmark"}:
        raise LabError("service mode must be 'cline' or 'benchmark'")
    try:
        state["auto_idle_seconds"] = int(state["auto_idle_seconds"])
    except (TypeError, ValueError) as exc:
        raise LabError("auto_idle_seconds must be an integer") from exc
    if state["auto_idle_seconds"] <= 0:
        raise LabError("auto_idle_seconds must be greater than zero")
    return state


def save_service_state(state):
    path = service_state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    normalized = {key: state.get(key, value) for key, value in DEFAULT_SERVICE_STATE.items()}
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(normalized, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temp, path)
    return path


def update_service_state(**changes):
    state = load_service_state()
    state.update(changes)
    save_service_state(state)
    return state


def runtime_config(cfg, state=None):
    state = state or load_service_state()
    effective = copy.deepcopy(cfg)
    idle_seconds = state["auto_idle_seconds"]
    test_override = project_env("IDLE_SECONDS_OVERRIDE")
    if test_override:
        try:
            idle_seconds = int(test_override)
        except ValueError as exc:
            raise LabError("AI_SYSTEMS_LAB_IDLE_SECONDS_OVERRIDE must be an integer") from exc
        if idle_seconds <= 0:
            raise LabError("AI_SYSTEMS_LAB_IDLE_SECONDS_OVERRIDE must be greater than zero")
    # The gateway, not llama.cpp, performs unload-on-idle. llama.cpp sleep
    # leaves weights resident, which is not the intended Cline behavior.
    effective["server"]["sleep_idle_seconds"] = None
    preset_defaults = effective.setdefault("preset_defaults", {})
    preset_defaults.pop("sleep-idle-seconds", None)
    if state["manual_unloaded"] or state["mode"] == "cline":
        for entry in effective.get("models", {}).values():
            entry.setdefault("preset", {})["load-on-startup"] = False
    return effective


def repo_path(value):
    path = Path(os.path.expanduser(str(value)))
    if not path.is_absolute():
        path = REPO_ROOT / path
    return path.resolve()


def paths(cfg):
    raw = cfg.get("paths", {})
    models_dir = repo_path(raw.get("models_dir", "~/Models/ai-systems-lab"))
    legacy_models_dir = raw.get("legacy_models_dir")
    if not models_dir.exists() and legacy_models_dir:
        legacy_path = repo_path(legacy_models_dir)
        warning_key = (models_dir, legacy_path)
        if legacy_path.exists():
            if warning_key not in _LEGACY_MODELS_WARNINGS:
                print(
                    f"warning: using legacy models directory {legacy_path}; configure models_dir to migrate",
                    file=sys.stderr,
                )
                _LEGACY_MODELS_WARNINGS.add(warning_key)
            models_dir = legacy_path
    return {
        "models_dir": models_dir,
        "state_dir": repo_path(raw.get("state_dir", ".ai-systems-lab")),
        "generated_dir": repo_path(raw.get("generated_dir", "config/generated")),
        "results_dir": repo_path(raw.get("results_dir", "benchmarks/results")),
    }


def expand_value(value, cfg):
    if not isinstance(value, str):
        return value
    p = paths(cfg)
    replacements = {
        "${repo}": str(REPO_ROOT),
        "${home}": str(Path.home()),
        "${models_dir}": str(p["models_dir"]),
        "${state_dir}": str(p["state_dir"]),
        "${generated_dir}": str(p["generated_dir"]),
        "${results_dir}": str(p["results_dir"]),
    }
    for key, replacement in replacements.items():
        value = value.replace(key, replacement)
    return os.path.expanduser(value)


def config_hash(cfg):
    normalized = json.dumps({k: v for k, v in cfg.items() if not k.startswith("_")}, sort_keys=True).encode()
    return hashlib.sha256(normalized).hexdigest()[:12]


def which(binary):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory) / binary
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def require_binary(binary):
    found = which(binary)
    if not found:
        raise LabError(f"Required binary not found on PATH: {binary}")
    return found


def hf_binary():
    return which("hf") or which("huggingface-cli")


def model_entry(cfg, model_id):
    models = cfg.get("models", {})
    if model_id not in models:
        raise LabError(f"Unknown model '{model_id}'. Run 'scripts/lab models-config' to list configured aliases.")
    return models[model_id]


def is_embedding_model(cfg, model_id):
    entry = cfg.get("models", {}).get(model_id, {})
    preset = entry.get("preset", {})
    return bool(entry.get("embedding") or entry.get("type") == "embedding" or preset.get("embeddings") is True)


def embedding_model_ids(cfg):
    return [model_id for model_id in cfg.get("models", {}) if is_embedding_model(cfg, model_id)]


def use_case_entry(cfg, use_case):
    use_cases = cfg.get("use_cases", {})
    if use_case not in use_cases:
        raise LabError(f"Unknown use case '{use_case}'. Known use cases: {', '.join(sorted(use_cases))}")
    return use_cases[use_case]


def resolve_selector(cfg, selector):
    if selector in cfg.get("models", {}):
        return selector
    if selector in cfg.get("use_cases", {}):
        default_model = cfg["use_cases"][selector].get("default_model")
        if not default_model:
            raise LabError(f"Use case '{selector}' has no default_model.")
        model_entry(cfg, default_model)
        return default_model
    raise LabError(f"'{selector}' is neither a configured model alias nor a use case.")


def selector_models(cfg, selector, all_candidates=False):
    if selector in cfg.get("use_cases", {}):
        entry = use_case_entry(cfg, selector)
        if all_candidates:
            result = entry.get("candidate_models") or [entry["default_model"]]
        else:
            result = [entry["default_model"]]
        for model_id in result:
            model_entry(cfg, model_id)
        return result
    return [resolve_selector(cfg, selector)]


def model_local_dir(cfg, model_id):
    entry = model_entry(cfg, model_id)
    local_dir = entry.get("local_dir", model_id)
    return paths(cfg)["models_dir"] / local_dir


def model_filename(entry):
    if entry.get("model_file"):
        return entry["model_file"]
    files = entry.get("files") or []
    if len(files) == 1:
        return files[0]
    raise LabError("Model entries with multiple files or includes must set model_file.")


def model_path(cfg, model_id):
    entry = model_entry(cfg, model_id)
    explicit = entry.get("path")
    if explicit:
        expanded = expand_value(explicit, cfg)
        path = Path(expanded)
        if not path.is_absolute():
            path = REPO_ROOT / path
        return path.resolve()
    return (model_local_dir(cfg, model_id) / model_filename(entry)).resolve()


def generated_preset_path(cfg):
    return paths(cfg)["generated_dir"] / "models.ini"


def state_file(cfg, name):
    return paths(cfg)["state_dir"] / name


def api_base(cfg):
    server = cfg.get("server", {})
    return f"http://{server.get('host', '127.0.0.1')}:{server.get('port', 8080)}"


def model_target(cfg, model_id):
    return resolve_model_target(cfg, model_id, f"{api_base(cfg)}/v1")


def require_local_model(cfg, model_id, operation):
    target = model_target(cfg, model_id)
    if not target.is_local:
        raise LabError(
            f"{operation} requires a local llama.cpp model; "
            f"'{model_id}' uses provider '{target.provider}'"
        )
    return target


def router_models_max(cfg):
    value = cfg.get("server", {}).get("models_max")
    if value in (None, "auto"):
        return max(1, 1 + len(embedding_model_ids(cfg)))
    return int(value)


def json_request(method, url, payload=None, timeout=300, headers=None):
    data = None
    request_headers = {"Content-Type": "application/json"}
    if headers:
        request_headers.update(headers)
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(url, data=data, headers=request_headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read().decode("utf-8")
            if not body:
                return {}
            return json.loads(body)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise LabHttpError(method, url, exc.code, body) from exc


def bool_ini(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if value is None:
        return ""
    return str(value)


def render_presets(cfg):
    validate_provider_config(cfg)
    out = generated_preset_path(cfg)
    out.parent.mkdir(parents=True, exist_ok=True)

    lines = [
        "; Generated by scripts/lab presets. Edit config/lab.json instead.",
        "version = 1",
        "",
        "[*]",
    ]
    for key, value in cfg.get("preset_defaults", {}).items():
        lines.append(f"{key} = {bool_ini(value)}")

    for model_id in sorted(cfg.get("models", {})):
        if not model_target(cfg, model_id).is_local:
            continue
        entry = model_entry(cfg, model_id)
        if entry.get("status") == "retired":
            continue
        lines.extend(["", f"[{model_id}]", f"model = {model_path(cfg, model_id)}"])
        for key, value in entry.get("preset", {}).items():
            value = expand_value(value, cfg)
            lines.append(f"{key} = {bool_ini(value)}")

    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return out


def validate_startup_models(cfg):
    missing = []
    for model_id in sorted(cfg.get("models", {})):
        preset = model_entry(cfg, model_id).get("preset", {})
        if preset.get("load-on-startup") is True:
            path = model_path(cfg, model_id)
            if not path.exists():
                missing.append((model_id, path))
    if missing:
        lines = ["load-on-startup model files are missing:"]
        for model_id, path in missing:
            lines.append(f"  {model_id}: {path}")
        lines.append("Pull the default model first, e.g. './scripts/lab pull coder', or set load-on-startup false in config/lab.json.")
        raise LabError("\n".join(lines))


def require_model_files(cfg, model_ids, selector, skip_missing=False):
    missing = []
    present = []
    for model_id in model_ids:
        path = model_path(cfg, model_id)
        if path.exists():
            present.append(model_id)
        else:
            missing.append((model_id, path))

    if missing and skip_missing:
        for model_id, path in missing:
            print(f"skipping {model_id}: missing {path}", file=sys.stderr)
        if not present:
            raise LabError("No benchmark models are available after skipping missing files.")
        return present

    if missing:
        lines = ["model files are missing:"]
        for model_id, path in missing:
            lines.append(f"  {model_id}: {path}")
        lines.append(f"Pull them first with './scripts/lab pull {selector} --all-candidates', run without --all-candidates, or pass --skip-missing.")
        raise LabError("\n".join(lines))

    return present


def benchmark_models_with_local_files(cfg, model_ids, selector, skip_missing=False):
    local_model_ids = [
        model_id for model_id in model_ids if model_target(cfg, model_id).is_local
    ]
    if not local_model_ids:
        return model_ids
    if not skip_missing:
        require_model_files(cfg, local_model_ids, selector)
        return model_ids

    available_local_model_ids = []
    for model_id in local_model_ids:
        path = model_path(cfg, model_id)
        if path.exists():
            available_local_model_ids.append(model_id)
        else:
            print(f"skipping {model_id}: missing {path}", file=sys.stderr)
    available_local_model_ids = set(available_local_model_ids)
    available_model_ids = [
        model_id
        for model_id in model_ids
        if not model_target(cfg, model_id).is_local or model_id in available_local_model_ids
    ]
    if not available_model_ids:
        raise LabError("No benchmark models are available after skipping missing files.")
    return available_model_ids


def pid_running(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def read_pid(cfg):
    pid_path = state_file(cfg, "server.pid")
    if not pid_path.exists():
        return None
    try:
        return int(pid_path.read_text(encoding="utf-8").strip())
    except ValueError:
        return None


def wait_for_models_endpoint(cfg, deadline_seconds):
    deadline = time.time() + deadline_seconds
    last_error = None
    while time.time() < deadline:
        try:
            return json_request("GET", f"{api_base(cfg)}/models", timeout=3)
        except Exception as exc:
            last_error = exc
            time.sleep(0.5)
    raise LabError(f"Server did not respond at {api_base(cfg)}/models within {deadline_seconds}s: {last_error}")


def skill_eval_dependencies():
    promptfoo = which(str(REPO_ROOT / "node_modules" / ".bin" / "promptfoo"))
    sdk_version = None
    lock_path = REPO_ROOT / "package-lock.json"
    if lock_path.exists():
        try:
            package_lock = json.loads(lock_path.read_text(encoding="utf-8"))
            sdk_versions = {
                package.get("version")
                for path, package in (package_lock.get("packages") or {}).items()
                if path.endswith("node_modules/@openai/codex-sdk")
            }
            if sdk_versions == {"0.147.0"}:
                sdk_version = "0.147.0"
        except (OSError, json.JSONDecodeError):
            pass
    return {"promptfoo": promptfoo, "codex_sdk": sdk_version}


def require_skill_eval_dependencies():
    dependencies = skill_eval_dependencies()
    if not dependencies["promptfoo"] or dependencies["codex_sdk"] != "0.147.0":
        raise LabError(
            "Skill evaluation dependencies are unavailable or out of date. "
            "Run `npm ci` from the repository root."
        )
    return dependencies


def binary_version(binary):
    if not binary:
        return None
    try:
        result = subprocess.run(
            [binary, "--version"],
            text=True,
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode:
        return None
    value = (result.stdout or result.stderr).strip()
    return value or None


def verify_responses_endpoint(cfg, timeout):
    url = f"{api_base(cfg)}/v1/responses"
    try:
        json_request("GET", url, timeout=timeout)
    except LabHttpError as exc:
        if exc.status == 404:
            raise LabError(
                f"Local server is incompatible with skill evaluation: {url} is unavailable. "
                "Use a llama.cpp server that supports /v1/responses."
            ) from exc
        if exc.status != 405:
            raise


def command_to_string(command):
    return " ".join(shlex.quote(str(part)) for part in command)


def cmd_doctor(args, cfg):
    validate_catalog_config(cfg)
    checks = [
        ("python", sys.executable),
        ("llama-server", cfg.get("server", {}).get("binary", "llama-server")),
        ("llama-bench", cfg.get("benchmarks", {}).get("llama_bench_binary", "llama-bench")),
    ]
    hf = hf_binary()
    print(f"repo: {REPO_ROOT}")
    print(f"config: {cfg['_config_path']}")
    if cfg.get("_local_config_path"):
        print(f"local config: {cfg['_local_config_path']}")
    for label, binary in checks:
        found = which(binary) if label != "python" else binary
        status = found or "missing"
        print(f"{label}: {status}")
    print(f"huggingface cli: {hf or 'missing'}")
    skill_dependencies = skill_eval_dependencies()
    print(f"promptfoo: {binary_version(skill_dependencies['promptfoo']) or 'missing'}")
    print(f"codex sdk: {skill_dependencies['codex_sdk'] or 'missing'}")
    for label, path in paths(cfg).items():
        print(f"{label}: {path}")
    print(f"api_base: {api_base(cfg)}/v1")
    print(f"router_models_max: {router_models_max(cfg)}")
    print(f"models_autoload: {cfg.get('server', {}).get('models_autoload', False)}")
    missing = [label for label, binary in checks if label != "python" and not which(binary)]
    if not hf:
        missing.append("hf or huggingface-cli")
    if missing:
        raise LabError("Missing required tools: " + ", ".join(missing))


def cmd_models_config(args, cfg):
    print("Configured use cases:")
    for use_case, entry in sorted(cfg.get("use_cases", {}).items()):
        candidates = ", ".join(entry.get("candidate_models", []))
        print(f"  {use_case}: default={entry.get('default_model')} candidates=[{candidates}]")
    print("\nConfigured models:")
    for model_id, entry in sorted(cfg.get("models", {}).items()):
        path = model_path(cfg, model_id)
        exists = "yes" if path.exists() else "no"
        print(f"  {model_id}: exists={exists} path={path}")


def model_weight_paths(cfg, model_id):
    entry = model_entry(cfg, model_id)
    configured_files = entry.get("files") or []
    explicit = entry.get("path")
    if explicit and configured_files:
        first_path = model_path(cfg, model_id)
        return [first_path.parent / Path(filename).name for filename in configured_files]
    if configured_files:
        return [model_local_dir(cfg, model_id) / filename for filename in configured_files]
    return [model_path(cfg, model_id)]


CATALOG_REQUIRED_FIELDS = {
    "release_date",
    "official_model_id",
    "architecture",
    "parameters_total_b",
    "parameters_active_b",
    "quantization",
    "license",
    "roles",
    "status",
    "expected_disk_gib",
    "context_tokens",
    "source_url",
    "last_verified",
    "agent_compatibility",
}


def validate_catalog_config(cfg):
    validate_provider_config(cfg)
    errors = []
    for section in ["models", "watchlist"]:
        for model_id, entry in cfg.get(section, {}).items():
            missing = sorted(CATALOG_REQUIRED_FIELDS - set(entry))
            if missing:
                errors.append(f"{model_id}: missing {', '.join(missing)}")
            if entry.get("status") not in {"core", "candidate", "retired", "watch"}:
                errors.append(f"{model_id}: invalid lifecycle status {entry.get('status')!r}")
            if not isinstance(entry.get("roles"), list):
                errors.append(f"{model_id}: roles must be a list")
            if not isinstance(entry.get("agent_compatibility"), dict):
                errors.append(f"{model_id}: agent_compatibility must be an object")
            if section == "models":
                preset_context = entry.get("preset", {}).get("ctx-size")
                if model_target(cfg, model_id).is_local and preset_context != entry.get("context_tokens"):
                    errors.append(
                        f"{model_id}: context_tokens {entry.get('context_tokens')} "
                        f"does not match preset ctx-size {preset_context}"
                    )
    if errors:
        raise LabError("Invalid model catalog:\n  " + "\n  ".join(errors))


def catalog_rows(cfg, role=None, status=None):
    entries = {}
    for model_id, entry in cfg.get("models", {}).items():
        entries[model_id] = (entry, True)
    for model_id, entry in cfg.get("watchlist", {}).items():
        entries[model_id] = (entry, False)

    rows = []
    for model_id, (entry, runnable) in sorted(entries.items()):
        roles = entry.get("roles", [])
        if role and role not in roles:
            continue
        if status and entry.get("status") != status:
            continue
        target = model_target(cfg, model_id) if runnable else None
        local = target is not None and target.is_local
        files = model_weight_paths(cfg, model_id) if local else []
        installed = bool(files) and all(path.exists() for path in files) if local else None
        installed_bytes = sum(path.stat().st_size for path in files if path.exists())
        partial_bytes = 0
        if local:
            local_dir = model_local_dir(cfg, model_id)
            if local_dir.exists():
                partial_bytes = sum(
                    path.stat().st_size
                    for path in local_dir.glob(".cache/**/*.incomplete")
                    if path.is_file()
                )
        rows.append({
            "model": model_id,
            "status": entry.get("status", "candidate"),
            "roles": roles,
            "quantization": entry.get("quantization"),
            "license": entry.get("license"),
            "parameters_total_b": entry.get("parameters_total_b"),
            "parameters_active_b": entry.get("parameters_active_b"),
            "context_tokens": entry.get("context_tokens"),
            "expected_disk_gib": entry.get("expected_disk_gib"),
            "installed": installed,
            "installed_gib": round(installed_bytes / (1024 ** 3), 2) if installed_bytes else 0,
            "partial_gib": round(partial_bytes / (1024 ** 3), 2) if partial_bytes else 0,
            "last_verified": entry.get("last_verified"),
            "official_model_id": entry.get("official_model_id"),
            "source_url": entry.get("source_url"),
            "agent_compatibility": entry.get("agent_compatibility", {}),
            "provider": target.provider if target else None,
            "provider_type": target.provider_type if target else None,
            "availability": "local" if local else "remote" if runnable else "watchlist",
        })
    return rows


def installed_fleet_gib(cfg):
    return sum(
        row["installed_gib"] + row["partial_gib"]
        for row in catalog_rows(cfg)
        if row["status"] in {"core", "candidate"}
    )


def cmd_catalog(args, cfg):
    validate_catalog_config(cfg)
    rows = catalog_rows(cfg, role=args.role, status=args.status)
    if args.format == "json":
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("No catalog entries matched the requested filters.")
        return
    headers = ["MODEL", "PROVIDER", "STATUS", "ROLES", "QUANT", "PARAMS", "DISK", "AVAILABLE", "VERIFIED"]
    table_rows = []
    for row in rows:
        total = row["parameters_total_b"]
        active = row["parameters_active_b"]
        params = "?"
        if total is not None:
            params = f"{total:g}B"
            if active is not None and active != total:
                params += f"/{active:g}B active"
        expected = row["expected_disk_gib"]
        disk = f"{expected:g} GiB" if expected is not None else "?"
        if row["availability"] == "remote":
            available = "remote"
        elif row["availability"] == "watchlist":
            available = "watchlist"
        elif row["installed"]:
            available = f"yes ({row['installed_gib']:g} GiB)"
        elif row["partial_gib"]:
            available = f"partial ({row['partial_gib']:g} GiB)"
        else:
            available = "no"
        table_rows.append([
            row["model"],
            row["provider"] or "-",
            row["status"],
            ",".join(row["roles"]) or "-",
            row["quantization"] or "-",
            params,
            disk,
            available,
            row["last_verified"] or "-",
        ])
    widths = [
        max(len(str(value)) for value in [header] + [row[index] for row in table_rows])
        for index, header in enumerate(headers)
    ]
    print("  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)))
    print("  ".join("-" * width for width in widths))
    for row in table_rows:
        print("  ".join(str(value).ljust(widths[index]) for index, value in enumerate(row)))
    cap = cfg.get("fleet", {}).get("installed_weight_cap_gib")
    if cap is not None and not args.role and not args.status:
        print(f"\nInstalled core/candidate weights: {installed_fleet_gib(cfg):g} / {cap:g} GiB")


def validate_pull_capacity(cfg, model_ids):
    cap = cfg.get("fleet", {}).get("installed_weight_cap_gib")
    if cap is None:
        return
    projected = installed_fleet_gib(cfg)
    rows = {row["model"]: row for row in catalog_rows(cfg)}
    for model_id in model_ids:
        row = rows[model_id]
        if not row["installed"]:
            expected = row.get("expected_disk_gib")
            if expected is None:
                raise LabError(
                    f"Cannot enforce the {cap:g} GiB fleet cap for {model_id}; "
                    "expected_disk_gib is missing."
                )
            downloaded = row["installed_gib"] + row["partial_gib"]
            projected += max(0, expected - downloaded)
    if projected > cap:
        raise LabError(
            f"Pull would project {projected:.1f} GiB of core/candidate weights, "
            f"above the {cap:g} GiB fleet cap. Retire or trash a superseded "
            "model before downloading."
        )


def pull_one(cfg, model_id, dry_run=False, force=False):
    require_local_model(cfg, model_id, "pull")
    entry = model_entry(cfg, model_id)
    if entry.get("status") == "retired":
        raise LabError(
            f"{model_id} is retired. Change its lifecycle status before "
            "re-downloading it."
        )
    if not entry.get("repo_id"):
        print(f"{model_id}: local-only model, skipping pull")
        return
    binary = hf_binary()
    if not binary:
        raise LabError("Neither 'hf' nor 'huggingface-cli' is available on PATH.")

    local_dir = model_local_dir(cfg, model_id)
    local_dir.mkdir(parents=True, exist_ok=True)

    command = [binary, "download", entry["repo_id"]]
    command.extend(entry.get("files") or [])
    for pattern in entry.get("include", []):
        command.extend(["--include", pattern])
    for pattern in entry.get("exclude", []):
        command.extend(["--exclude", pattern])
    if entry.get("revision"):
        command.extend(["--revision", str(entry["revision"])])
    command.extend(["--local-dir", str(local_dir)])
    if dry_run:
        command.append("--dry-run")
    if force:
        command.append("--force-download")

    print(f"{model_id}: {command_to_string(command)}", flush=True)
    subprocess.run(command, check=True)


def cmd_pull(args, cfg):
    if args.selector == "all":
        raise LabError(
            "Bulk pull-all is disabled. Download explicit aliases in small, "
            "medium, and flagship waves."
        )
    else:
        model_ids = selector_models(cfg, args.selector, all_candidates=args.all_candidates)
    validate_pull_capacity(cfg, model_ids)
    for model_id in model_ids:
        pull_one(cfg, model_id, dry_run=args.dry_run, force=args.force)


def cmd_presets(args, cfg):
    out = render_presets(runtime_config(cfg))
    print(out)


def service_target():
    return f"gui/{os.getuid()}/{SERVICE_LABEL}"


def legacy_service_target():
    return f"gui/{os.getuid()}/{LEGACY_SERVICE_LABEL}"


def service_is_loaded():
    result = subprocess.run(
        ["launchctl", "print", service_target()],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def service_is_legacy_loaded():
    result = subprocess.run(
        ["launchctl", "print", legacy_service_target()],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def api_is_ready(cfg):
    try:
        json_request("GET", f"{api_base(cfg)}/models", timeout=2)
        return True
    except Exception:
        return False


def listener_pids(cfg):
    lsof = which("lsof") or "/usr/sbin/lsof"
    if not Path(lsof).exists():
        return []
    port = cfg.get("server", {}).get("port", 8080)
    result = subprocess.run(
        [lsof, "-nP", "-t", f"-iTCP:{port}", "-sTCP:LISTEN"],
        text=True,
        capture_output=True,
    )
    pids = []
    for value in result.stdout.splitlines():
        try:
            pids.append(int(value.strip()))
        except ValueError:
            continue
    return sorted(set(pids))


def process_command(pid):
    result = subprocess.run(
        ["ps", "-p", str(pid), "-o", "command="],
        text=True,
        capture_output=True,
    )
    return result.stdout.strip()


def is_lab_server_process(pid, cfg):
    command = process_command(pid)
    preset = str(generated_preset_path(cfg))
    return ("llama-server" in command and (preset in command or str(REPO_ROOT) in command)) or (
        str(Path(__file__).resolve()) in command and "serve" in command
    )


def stop_pid(pid, wait=15, force=False):
    if not pid_running(pid):
        return
    os.kill(pid, signal.SIGTERM)
    deadline = time.time() + wait
    while time.time() < deadline:
        if not pid_running(pid):
            return
        time.sleep(0.25)
    if force:
        os.kill(pid, signal.SIGKILL)
        return
    raise LabError(f"server pid={pid} did not stop within {wait}s")


def stop_ad_hoc_server(cfg, wait=15, force=False):
    candidates = listener_pids(cfg)
    pid = read_pid(cfg)
    if pid and pid_running(pid):
        candidates.append(pid)
    candidates = sorted(set(candidates))
    if not candidates:
        state_file(cfg, "server.pid").unlink(missing_ok=True)
        return []
    unknown = [candidate for candidate in candidates if not is_lab_server_process(candidate, cfg)]
    if unknown:
        details = "; ".join(f"pid={candidate} command={process_command(candidate)!r}" for candidate in unknown)
        raise LabError(f"Refusing to stop an unknown process using the local AI port: {details}")
    for candidate in candidates:
        stop_pid(candidate, wait=wait, force=force)
    state_file(cfg, "server.pid").unlink(missing_ok=True)
    return candidates


def backend_api_base(cfg):
    server = cfg.get("server", {})
    return f"http://{server.get('host', '127.0.0.1')}:{server.get('backend_port', 8081)}"


class Gateway:
    """Serializes llama.cpp model transitions before proxying OpenAI requests."""

    def __init__(self, cfg):
        self.cfg = cfg
        self.lock = threading.Lock()
        self.last_generation_request = time.monotonic()
        self.last_transition = None
        self.stop_idle = threading.Event()
        self.idle_thread = threading.Thread(target=self._idle_loop, daemon=True)
        self.idle_thread.start()

    def close(self):
        self.stop_idle.set()
        self.idle_thread.join(timeout=2)

    def _record(self, event, **details):
        row = {"at": dt.datetime.now(dt.timezone.utc).isoformat(), "event": event, **details}
        path = state_file(self.cfg, "gateway-events.jsonl")
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(row, sort_keys=True) + "\n")

    def _backend_models(self):
        return json_request("GET", f"{backend_api_base(self.cfg)}/models", timeout=10).get("data", [])

    def _status(self, model_id):
        for item in self._backend_models():
            if item.get("id") == model_id:
                return (item.get("status") or {}).get("value"), item
        return None, None

    def _wait_loaded(self, model_id, timeout):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            status, item = self._status(model_id)
            if status == "loaded":
                return item
            if item and (item.get("status") or {}).get("failed"):
                raise LabError(f"model {model_id} failed to load; inspect scripts/lab logs")
            time.sleep(1)
        raise LabError(f"model {model_id} did not finish loading within {timeout}s")

    def _unload(self, model_id):
        json_request("POST", f"{backend_api_base(self.cfg)}/models/unload", {"model": model_id}, timeout=300)
        deadline = time.monotonic() + 300
        while time.monotonic() < deadline:
            status, _ = self._status(model_id)
            if status not in ACTIVE_MODEL_STATES:
                return
            time.sleep(0.5)
        raise LabError(f"model {model_id} did not unload within 300s")

    def ensure_model(self, model_id):
        require_local_model(self.cfg, model_id, "gateway loading")
        entry = model_entry(self.cfg, model_id)
        if entry.get("status") == "retired":
            raise LabError(f"{model_id} is retired and cannot be loaded")
        missing = [path for path in model_weight_paths(self.cfg, model_id) if not path.exists()]
        if missing:
            raise LabError("model files are missing for " + model_id + ": " + ", ".join(str(path) for path in missing))
        state = load_service_state()
        if state["mode"] == "benchmark" and state.get("pinned_model") != model_id:
            raise LabError(f"benchmark mode is pinned to {state.get('pinned_model') or 'no model'}; automatic switching is disabled")
        if not is_embedding_model(self.cfg, model_id) and state["manual_unloaded"]:
            update_service_state(manual_unloaded=False)
        with self.lock:
            started = time.monotonic()
            status, _ = self._status(model_id)
            if status == "loaded":
                self.last_generation_request = time.monotonic()
                return {"model": model_id, "status": "already_loaded", "load_seconds": 0}
            unloaded = []
            if not is_embedding_model(self.cfg, model_id):
                for item in self._backend_models():
                    other = item.get("id")
                    other_status = (item.get("status") or {}).get("value")
                    if other != model_id and not is_embedding_model(self.cfg, other) and other_status in ACTIVE_MODEL_STATES:
                        self._unload(other)
                        unloaded.append(other)
            timeout = int(self.cfg.get("server", {}).get("load_timeout_seconds", 900))
            json_request("POST", f"{backend_api_base(self.cfg)}/models/load", {"model": model_id}, timeout=timeout)
            self._wait_loaded(model_id, timeout)
            elapsed = round(time.monotonic() - started, 3)
            self.last_transition = {"model": model_id, "unloaded": unloaded, "load_seconds": elapsed}
            self.last_generation_request = time.monotonic()
            self._record("model_loaded", **self.last_transition)
            return {"model": model_id, "status": "loaded", **self.last_transition}

    def _idle_loop(self):
        while not self.stop_idle.wait(5):
            try:
                state = load_service_state()
                if state["mode"] != "cline" or not state["auto_idle_enabled"]:
                    continue
                if time.monotonic() - self.last_generation_request < state["auto_idle_seconds"]:
                    continue
                with self.lock:
                    for item in self._backend_models():
                        model_id = item.get("id")
                        status = (item.get("status") or {}).get("value")
                        if not is_embedding_model(self.cfg, model_id) and status in ACTIVE_MODEL_STATES:
                            self._unload(model_id)
                            self._record("model_unloaded_idle", model=model_id)
            except Exception as exc:
                self._record("idle_unload_failed", error=str(exc))


class GatewayHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, format, *args):
        return

    def _json_error(self, status, message):
        body = json.dumps({"error": {"message": message, "type": "invalid_request_error"}}).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_body(self):
        return self.rfile.read(int(self.headers.get("Content-Length", "0")))

    def _proxy(self, body=None):
        gateway = self.server.gateway
        url = f"{backend_api_base(gateway.cfg)}{self.path}"
        headers = {key: value for key, value in self.headers.items() if key.lower() not in {"host", "content-length", "connection"}}
        request = urllib.request.Request(url, data=body, headers=headers, method=self.command)
        try:
            with urllib.request.urlopen(request, timeout=int(gateway.cfg["server"].get("request_timeout_seconds", 1800))) as response:
                streaming = response.headers.get_content_type() == "text/event-stream"
                self.send_response(response.status)
                for key, value in response.headers.items():
                    if key.lower() not in {"transfer-encoding", "connection", "content-length"}:
                        self.send_header(key, value)
                if streaming:
                    self.end_headers()
                    # Preserve token delivery for Cline instead of buffering a
                    # potentially long stream behind the gateway.
                    while chunk := response.read(8192):
                        self.wfile.write(chunk)
                        self.wfile.flush()
                    self.close_connection = True
                else:
                    data = response.read()
                    self.send_header("Content-Length", str(len(data)))
                    self.end_headers()
                    self.wfile.write(data)
        except urllib.error.HTTPError as exc:
            self.send_response(exc.code)
            data = exc.read()
            self.send_header("Content-Type", exc.headers.get("Content-Type", "application/json"))
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

    def _stable_models(self):
        data = [{"id": model_id, "object": "model", "owned_by": "ai-systems-lab"}
                for model_id, entry in sorted(self.server.gateway.cfg.get("models", {}).items())
                if entry.get("status") != "retired"]
        body = json.dumps({"object": "list", "data": data}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/v1/models":
            return self._stable_models()
        return self._proxy()

    def do_POST(self):
        body = self._read_body()
        if self.path == "/models/load":
            try:
                model_id = json.loads(body).get("model")
                result = self.server.gateway.ensure_model(model_id)
            except (json.JSONDecodeError, AttributeError, LabError) as exc:
                return self._json_error(400, str(exc))
            data = json.dumps(result).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        if self.path == "/models/unload":
            try:
                model_id = json.loads(body).get("model")
                if not isinstance(model_id, str):
                    raise LabError("unload requires a model alias")
                with self.server.gateway.lock:
                    self.server.gateway._unload(model_id)
                result = {"model": model_id, "status": "unloaded"}
            except (json.JSONDecodeError, AttributeError, LabError) as exc:
                return self._json_error(400, str(exc))
            data = json.dumps(result).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        if self.path in {"/v1/chat/completions", "/v1/completions", "/v1/embeddings"}:
            try:
                payload = json.loads(body)
                model_id = payload.get("model")
                if not isinstance(model_id, str):
                    raise LabError("request must include a catalog model alias")
                self.server.gateway.ensure_model(model_id)
            except (json.JSONDecodeError, LabError) as exc:
                return self._json_error(400 if "Unknown model" in str(exc) or "must include" in str(exc) else 409, str(exc))
        return self._proxy(body)


class GatewayServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address, cfg):
        self.gateway = Gateway(cfg)
        super().__init__(address, GatewayHandler)

    def server_close(self):
        self.gateway.close()
        super().server_close()


def server_command(cfg):
    server = cfg.get("server", {})
    binary = server.get("binary", "llama-server")
    binary_path = require_binary(binary)
    preset = render_presets(cfg)
    command = [
        binary_path,
        "--host", str(server.get("host", "127.0.0.1")),
        "--port", str(server.get("backend_port", 8081)),
        "--models-preset", str(preset),
        "--models-max", str(router_models_max(cfg)),
    ]
    command.append("--models-autoload" if server.get("models_autoload", False) else "--no-models-autoload")
    if server.get("metrics", False):
        command.append("--metrics")
    if server.get("sleep_idle_seconds") is not None:
        command.extend(["--sleep-idle-seconds", str(server["sleep_idle_seconds"])])
    command.extend(str(part) for part in server.get("extra_args", []))
    return command


def record_server_command(cfg, command, pid, mode):
    p = paths(cfg)
    p["state_dir"].mkdir(parents=True, exist_ok=True)
    state_file(cfg, "server.pid").write_text(str(pid), encoding="utf-8")
    state_file(cfg, "server.command.json").write_text(
        json.dumps(
            {
                "command": command,
                "mode": mode,
                "pid": pid,
                "started_at": dt.datetime.now().isoformat(),
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )


def launch_agent_payload(cfg):
    state_dir = paths(cfg)["state_dir"]
    state_dir.mkdir(parents=True, exist_ok=True)
    python = which("python3") or sys.executable
    return {
        "Label": SERVICE_LABEL,
        "ProgramArguments": [python, str(Path(__file__).resolve()), "--config", cfg["_config_path"], "serve"],
        "WorkingDirectory": str(REPO_ROOT),
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "ProcessType": "Interactive",
        "EnvironmentVariables": {
            "HOME": str(Path.home()),
            "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        },
        "StandardOutPath": str(state_file(cfg, "server.log")),
        "StandardErrorPath": str(state_file(cfg, "server.log")),
    }


def write_launch_agent(cfg):
    LAUNCH_AGENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    LAUNCH_AGENT_PATH.write_bytes(plistlib.dumps(launch_agent_payload(cfg), sort_keys=False))
    result = subprocess.run(["plutil", "-lint", str(LAUNCH_AGENT_PATH)], text=True, capture_output=True)
    if result.returncode != 0:
        raise LabError(f"Generated LaunchAgent is invalid: {result.stdout}{result.stderr}")
    return LAUNCH_AGENT_PATH


def wait_for_configured_startup_models(cfg, wait):
    effective = runtime_config(cfg)
    for model_id, entry in effective.get("models", {}).items():
        if entry.get("preset", {}).get("load-on-startup") is True:
            wait_for_loaded(cfg, model_id, timeout=wait)


def bootstrap_service(cfg, wait=120):
    if not LAUNCH_AGENT_PATH.exists():
        raise LabError(f"LaunchAgent is not installed: {LAUNCH_AGENT_PATH}. Run 'make service-install'.")
    if not service_is_loaded():
        result = subprocess.run(
            ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(LAUNCH_AGENT_PATH)],
            text=True,
            capture_output=True,
        )
        if result.returncode != 0:
            raise LabError(f"launchctl bootstrap failed: {(result.stderr or result.stdout).strip()}")
    wait_for_models_endpoint(cfg, wait)
    wait_for_configured_startup_models(cfg, wait)


def bootout_service():
    if not service_is_loaded():
        return False
    result = subprocess.run(
        ["launchctl", "bootout", service_target()],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise LabError(f"launchctl bootout failed: {(result.stderr or result.stdout).strip()}")
    return True


def restart_service(cfg, wait=120):
    if not service_is_loaded():
        bootstrap_service(cfg, wait=wait)
        return
    result = subprocess.run(
        ["launchctl", "kickstart", "-k", service_target()],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise LabError(f"launchctl kickstart failed: {(result.stderr or result.stdout).strip()}")
    wait_for_models_endpoint(cfg, wait)
    wait_for_configured_startup_models(cfg, wait)


def cmd_service_install(args, cfg):
    if LEGACY_LAUNCH_AGENT_PATH.exists() or service_is_legacy_loaded():
        raise LabError(
            "Legacy com.erik.local-ai-lab service is still installed. "
            "Run './scripts/lab service-uninstall-legacy' before installing "
            "com.erik.ai-systems-lab."
        )
    validate_startup_models(runtime_config(cfg))
    if service_is_loaded():
        bootout_service()
        time.sleep(0.5)
    stopped = stop_ad_hoc_server(cfg, wait=args.wait, force=args.force)
    if stopped:
        print("stopped existing ai-systems-lab server: " + ", ".join(str(pid) for pid in stopped))
    path = write_launch_agent(cfg)
    bootstrap_service(cfg, wait=args.startup_wait)
    print(f"LaunchAgent installed and running: {path}")


def cmd_service_start(args, cfg):
    if api_is_ready(cfg) and service_is_loaded():
        print(f"service already running: {service_target()}")
        return
    bootstrap_service(cfg, wait=args.wait)
    print(f"service started: {service_target()}")


def cmd_service_stop(args, cfg):
    if bootout_service():
        deadline = time.time() + args.wait
        while time.time() < deadline and api_is_ready(cfg):
            time.sleep(0.25)
        state_file(cfg, "server.pid").unlink(missing_ok=True)
        print(f"service stopped: {service_target()}")
    else:
        print("service is not loaded")


def cmd_service_restart(args, cfg):
    restart_service(cfg, wait=args.wait)
    print(f"service restarted: {service_target()}")


def cmd_service_uninstall(args, cfg):
    bootout_service()
    LAUNCH_AGENT_PATH.unlink(missing_ok=True)
    state_file(cfg, "server.pid").unlink(missing_ok=True)
    print(f"LaunchAgent uninstalled: {LAUNCH_AGENT_PATH}")


def cmd_service_uninstall_legacy(args, cfg):
    target = f"gui/{os.getuid()}/{LEGACY_SERVICE_LABEL}"
    subprocess.run(["launchctl", "bootout", target], check=False)
    if LEGACY_LAUNCH_AGENT_PATH.exists():
        LEGACY_LAUNCH_AGENT_PATH.unlink()
    print(f"legacy service removed: {LEGACY_SERVICE_LABEL}")


def cmd_serve(args, cfg):
    effective = runtime_config(cfg)
    validate_startup_models(effective)
    command = server_command(effective)
    p = paths(cfg)
    p["state_dir"].mkdir(parents=True, exist_ok=True)
    log_path = state_file(cfg, "server.log")
    with open(log_path, "ab") as log:
        log.write(f"\n--- {dt.datetime.now().isoformat()} gateway starting ---\n".encode("utf-8"))
        log.write((command_to_string(command) + "\n").encode("utf-8"))
        backend = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, cwd=str(REPO_ROOT))
    try:
        wait_for_models_endpoint_backend(cfg, 120)
        record_server_command(cfg, command, os.getpid(), "gateway")
        server = GatewayServer((effective["server"].get("host", "127.0.0.1"), effective["server"].get("port", 8080)), effective)
        try:
            server.serve_forever(poll_interval=0.5)
        finally:
            server.server_close()
    finally:
        if backend.poll() is None:
            backend.terminate()
            try:
                backend.wait(timeout=15)
            except subprocess.TimeoutExpired:
                backend.kill()


def wait_for_models_endpoint_backend(cfg, deadline_seconds):
    deadline = time.time() + deadline_seconds
    last_error = None
    while time.time() < deadline:
        try:
            return json_request("GET", f"{backend_api_base(cfg)}/models", timeout=3)
        except Exception as exc:
            last_error = exc
            time.sleep(0.5)
    raise LabError(f"Backend did not respond at {backend_api_base(cfg)}/models within {deadline_seconds}s: {last_error}")


def start_ad_hoc_server(args, cfg):
    effective = runtime_config(cfg)

    pid = read_pid(cfg)
    if pid and pid_running(pid):
        print(f"server already running pid={pid} base={api_base(cfg)}")
        return

    if not args.skip_model_check:
        validate_startup_models(effective)
    p = paths(cfg)
    p["state_dir"].mkdir(parents=True, exist_ok=True)
    log_path = state_file(cfg, "server.log")
    command = server_command(effective)

    with open(log_path, "ab") as log:
        log.write(f"\n--- {dt.datetime.now().isoformat()} starting ---\n".encode("utf-8"))
        log.write((command_to_string(command) + "\n").encode("utf-8"))
        proc = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, cwd=str(REPO_ROOT), start_new_session=True)

    record_server_command(cfg, command, proc.pid, "ad-hoc")
    try:
        wait_for_models_endpoint(cfg, args.wait)
    except LabError:
        tail = tail_file(log_path, 80)
        raise LabError(f"server started pid={proc.pid}, but readiness check failed. Log tail:\n{tail}")
    print(f"server started pid={proc.pid} base={api_base(cfg)} log={log_path}")


def cmd_start(args, cfg):
    if LAUNCH_AGENT_PATH.exists():
        cmd_service_start(argparse.Namespace(wait=max(args.wait, 120)), cfg)
        return
    start_ad_hoc_server(args, cfg)


def cmd_stop(args, cfg):
    if service_is_loaded():
        cmd_service_stop(argparse.Namespace(wait=args.wait), cfg)
        return
    pid_path = state_file(cfg, "server.pid")
    pid = read_pid(cfg)
    if not pid:
        print("server is not running")
        return
    if not pid_running(pid):
        pid_path.unlink(missing_ok=True)
        print(f"removed stale pid file for pid={pid}")
        return

    os.kill(pid, signal.SIGTERM)
    deadline = time.time() + args.wait
    while time.time() < deadline:
        if not pid_running(pid):
            pid_path.unlink(missing_ok=True)
            print(f"server stopped pid={pid}")
            return
        time.sleep(0.25)
    if args.force:
        os.kill(pid, signal.SIGKILL)
        pid_path.unlink(missing_ok=True)
        print(f"server killed pid={pid}")
        return
    raise LabError(f"server pid={pid} did not stop within {args.wait}s. Re-run with --force to SIGKILL.")


def cmd_status(args, cfg):
    status = collect_status(cfg)
    if args.format == "json":
        print(json.dumps(status, indent=2))
    elif args.format == "raycast":
        print(raycast_status_line(status))
    else:
        print_text_status(status)


def tail_file(path, lines):
    if not path.exists():
        return ""
    data = path.read_text(encoding="utf-8", errors="replace").splitlines()
    return "\n".join(data[-lines:])


def cmd_logs(args, cfg):
    print(tail_file(state_file(cfg, "server.log"), args.lines))


def cmd_list(args, cfg):
    data = json_request("GET", f"{api_base(cfg)}/models", timeout=10)
    print(json.dumps(data, indent=2))


ACTIVE_MODEL_STATES = {"loaded", "loading", "sleeping"}


def router_models(cfg, timeout=10):
    data = json_request("GET", f"{api_base(cfg)}/models", timeout=timeout)
    return data.get("data", [])


def router_model_status(cfg, model_id, timeout=10):
    for item in router_models(cfg, timeout=timeout):
        if item.get("id") == model_id:
            status = item.get("status") or {}
            return status.get("value"), item
    return None, None


def unload_model(cfg, model_id, quiet=False):
    try:
        response = json_request("POST", f"{api_base(cfg)}/models/unload", {"model": model_id}, timeout=300)
        if not quiet:
            print(json.dumps(response, indent=2))
    except LabHttpError as exc:
        if not quiet:
            print(f"unload {model_id}: {exc}")
    except Exception as exc:
        if not quiet:
            print(f"unload {model_id}: {exc}")


def active_model_ids(cfg, exclude=None, include_embeddings=True, timeout=10):
    exclude = set(exclude or [])
    result = []
    for item in router_models(cfg, timeout=timeout):
        model_id = item.get("id")
        status = item.get("status") or {}
        if not include_embeddings and is_embedding_model(cfg, model_id):
            continue
        if model_id not in exclude and status.get("value") in ACTIVE_MODEL_STATES:
            result.append(model_id)
    return result


def read_server_command(cfg):
    path = state_file(cfg, "server.command.json")
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def effective_idle_from_command(cfg):
    command = read_server_command(cfg).get("command") or []
    try:
        index = command.index("--sleep-idle-seconds")
        return int(command[index + 1])
    except (ValueError, IndexError, TypeError):
        return None


def process_tree_rss_gib(pid, model_id=None):
    if not pid or not pid_running(pid):
        return None
    result = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,rss=,command="],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    processes = {}
    children = {}
    for line in result.stdout.splitlines():
        parts = line.strip().split(maxsplit=3)
        if len(parts) < 3:
            continue
        try:
            process_pid = int(parts[0])
            parent_pid = int(parts[1])
            rss_kib = int(parts[2])
        except ValueError:
            continue
        command = parts[3] if len(parts) == 4 else ""
        processes[process_pid] = {"rss_kib": rss_kib, "command": command}
        children.setdefault(parent_pid, []).append(process_pid)
    if pid not in processes:
        return None

    selected = {pid}
    pending = [pid]
    while pending:
        parent = pending.pop()
        for child in children.get(parent, []):
            if child not in selected:
                selected.add(child)
                pending.append(child)
    if model_id:
        alias_pattern = re.compile(
            rf"(?:^|\s)--alias\s+{re.escape(model_id)}(?:\s|$)"
        )
        workers = {
            process_pid
            for process_pid in selected
            if alias_pattern.search(processes[process_pid]["command"])
        }
        if workers:
            selected = workers
    rss_kib = sum(processes[process_pid]["rss_kib"] for process_pid in selected)
    return rss_kib / (1024 ** 2)


def run_with_server_memory_sample(cfg, operation, model_id=None, interval_seconds=0.25):
    pid = read_pid(cfg)
    samples = []
    stop = threading.Event()

    def sample():
        while not stop.is_set():
            value = process_tree_rss_gib(pid, model_id=model_id)
            if value is not None:
                samples.append(value)
            stop.wait(interval_seconds)

    thread = None
    if pid and pid_running(pid):
        thread = threading.Thread(target=sample, daemon=True)
        thread.start()
    try:
        result = operation()
    finally:
        stop.set()
        if thread:
            thread.join(timeout=max(1, interval_seconds * 2))
        value = process_tree_rss_gib(pid, model_id=model_id)
        if value is not None:
            samples.append(value)
    peak = round(max(samples), 3) if samples else None
    return result, peak


def collect_status(cfg):
    state = load_service_state()
    pid = read_pid(cfg)
    pid_is_running = bool(pid and pid_running(pid))
    api_ready = False
    api_error = None
    raw_models = []
    try:
        raw_models = router_models(cfg, timeout=3)
        api_ready = True
    except Exception as exc:
        api_error = str(exc)

    models = []
    for item in raw_models:
        model_id = item.get("id")
        model_status = item.get("status") or {}
        models.append(
            {
                "id": model_id,
                "state": model_status.get("value", "unknown"),
                "failed": bool(model_status.get("failed")),
                "embedding": is_embedding_model(cfg, model_id),
            }
        )

    non_embedding = [item for item in models if not item["embedding"] and item["state"] in ACTIVE_MODEL_STATES]
    preferred = resolve_selector(cfg, "coder")
    preferred_item = next((item for item in non_embedding if item["id"] == preferred), None)
    current = preferred_item or (non_embedding[0] if non_embedding else None)

    if not api_ready:
        readiness = "offline"
    elif state["manual_unloaded"] and current is None:
        readiness = "manual_unloaded"
    elif current:
        readiness = current["state"]
    else:
        readiness = "unloaded"

    return {
        "service": {
            "label": SERVICE_LABEL,
            "installed": LAUNCH_AGENT_PATH.exists(),
            "loaded": service_is_loaded(),
            "pid": pid,
            "pid_running": pid_is_running,
        },
        "api": {
            "base_url": f"{api_base(cfg)}/v1",
            "ready": api_ready,
            "error": api_error,
        },
        "preferences": state,
        "effective_auto_idle_seconds": effective_idle_from_command(cfg) if pid_is_running else None,
        "default_model": preferred,
        "active_model": current,
        "readiness": readiness,
        "models": models,
    }


def auto_idle_label(status):
    state = status["preferences"]
    if state["auto_idle_enabled"]:
        minutes = state["auto_idle_seconds"] // 60
        return f"Auto-idle ON ({minutes}m)"
    return "Auto-idle OFF"


def raycast_status_line(status):
    readiness = status["readiness"]
    idle = auto_idle_label(status)
    model = status.get("active_model") or {}
    model_id = model.get("id", status["default_model"])
    if readiness == "loaded":
        return f"🟢 Loaded: {model_id} · {idle} · Service running"
    if readiness == "loading":
        return f"🟡 Loading: {model_id} · {idle}"
    if readiness == "sleeping":
        return f"🟡 Sleeping: {model_id} · Auto-wake enabled"
    if readiness == "manual_unloaded":
        return f"⚪ Manually unloaded · {idle} · Load required"
    if readiness == "unloaded":
        return f"⚪ Unloaded · {idle} · Load required"
    return f"🔴 Service offline · {idle}"


def print_text_status(status):
    service = status["service"]
    api = status["api"]
    print(f"service_installed: {'yes' if service['installed'] else 'no'}")
    print(f"service_loaded: {'yes' if service['loaded'] else 'no'}")
    print(f"server_pid: {service['pid'] if service['pid'] else 'none'}")
    print(f"server_running: {'yes' if service['pid_running'] else 'no'}")
    print(f"api_base: {api['base_url']}")
    print(f"api_ready: {'yes' if api['ready'] else 'no'}")
    print(f"auto_idle: {'on' if status['preferences']['auto_idle_enabled'] else 'off'}")
    print(f"auto_idle_seconds: {status['preferences']['auto_idle_seconds']}")
    effective = status["effective_auto_idle_seconds"]
    print(f"effective_auto_idle_seconds: {effective if effective is not None else 'disabled'}")
    print(f"manual_unloaded: {'yes' if status['preferences']['manual_unloaded'] else 'no'}")
    print(f"readiness: {status['readiness']}")
    if status["active_model"]:
        print(f"active_model: {status['active_model']['id']}")
    if api["error"]:
        print(f"api_error: {api['error']}")
    for model in status["models"]:
        kind = "embedding" if model["embedding"] else "generation"
        failed = " failed" if model["failed"] else ""
        print(f"model: {model['id']} state={model['state']} type={kind}{failed}")


def wait_for_inactive(cfg, model_id, timeout=300):
    deadline = time.time() + timeout
    while time.time() < deadline:
        status, _ = router_model_status(cfg, model_id, timeout=10)
        if status not in ACTIVE_MODEL_STATES:
            return
        time.sleep(0.5)
    raise LabError(f"model {model_id} did not unload within {timeout}s")


def unload_other_models(cfg, selected_model, timeout=300):
    if is_embedding_model(cfg, selected_model):
        return []
    unloaded = []
    for model_id in active_model_ids(cfg, exclude={selected_model}, include_embeddings=False):
        unload_model(cfg, model_id, quiet=True)
        wait_for_inactive(cfg, model_id, timeout=timeout)
        unloaded.append(model_id)
    return unloaded


def wait_for_loaded(cfg, model_id, timeout=900):
    deadline = time.time() + timeout
    while time.time() < deadline:
        status, item = router_model_status(cfg, model_id, timeout=10)
        if status == "loaded":
            return item
        if item and (item.get("status") or {}).get("failed"):
            raise LabError(f"model {model_id} failed to load. Check './scripts/lab logs'.")
        time.sleep(1)
    raise LabError(f"model {model_id} did not finish loading within {timeout}s")


def switch_to_model(cfg, model_id, timeout=900):
    if model_entry(cfg, model_id).get("status") == "retired":
        raise LabError(f"{model_id} is retired and cannot be loaded.")
    path = model_path(cfg, model_id)
    if not path.exists():
        raise LabError(f"model file does not exist for {model_id}: {path}. Pull it first with './scripts/lab pull {model_id}'.")

    unloaded = unload_other_models(cfg, model_id, timeout=timeout)
    status, _ = router_model_status(cfg, model_id, timeout=min(timeout, 30))
    if status == "loaded":
        return {"model": model_id, "status": "already_loaded", "unloaded": unloaded}
    if status == "loading":
        wait_for_loaded(cfg, model_id, timeout=timeout)
        return {"model": model_id, "status": "loaded", "unloaded": unloaded}

    try:
        response = json_request("POST", f"{api_base(cfg)}/models/load", {"model": model_id}, timeout=timeout)
    except LabHttpError as exc:
        if exc.status == 400 and "already running" in str(exc):
            return {"model": model_id, "status": "already_loaded", "unloaded": unloaded}
        raise
    wait_for_loaded(cfg, model_id, timeout=timeout)
    unload_other_models(cfg, model_id, timeout=timeout)
    if isinstance(response, dict):
        response.setdefault("model", model_id)
        response["unloaded"] = unloaded
        return response
    return {"model": model_id, "status": "loaded", "unloaded": unloaded}


def cmd_load(args, cfg):
    model_id = resolve_selector(cfg, args.selector)
    require_local_model(cfg, model_id, "load")
    if not is_embedding_model(cfg, model_id):
        update_service_state(manual_unloaded=False)
    if not api_is_ready(cfg):
        if LAUNCH_AGENT_PATH.exists():
            bootstrap_service(cfg, wait=args.timeout)
        else:
            raise LabError("AI Systems Lab server is offline. Run 'make start' or 'make service-install' first.")
    response = switch_to_model(cfg, model_id, timeout=args.timeout)
    print(json.dumps(response, indent=2))


def cmd_switch(args, cfg):
    model_id = resolve_selector(cfg, args.selector)
    require_local_model(cfg, model_id, "switch")
    cmd_load(args, cfg)


def cmd_unload(args, cfg):
    model_id = resolve_selector(cfg, args.selector)
    require_local_model(cfg, model_id, "unload")
    if not is_embedding_model(cfg, model_id):
        update_service_state(manual_unloaded=True)
    unload_model(cfg, model_id, quiet=False)


def cmd_unload_active(args, cfg):
    update_service_state(manual_unloaded=True)
    if not api_is_ready(cfg):
        print("manual unload saved; service is offline")
        return
    active = active_model_ids(cfg, include_embeddings=False, timeout=10)
    if not active:
        print("no active non-embedding models; manual unload saved")
        return
    for model_id in active:
        unload_model(cfg, model_id, quiet=True)
        wait_for_inactive(cfg, model_id, timeout=args.timeout)
    print("manually unloaded: " + ", ".join(active))


def cmd_auto_idle(args, cfg):
    state = load_service_state()
    if args.action == "status":
        label = "enabled" if state["auto_idle_enabled"] else "disabled"
        print(f"auto-idle {label} ({state['auto_idle_seconds']} seconds)")
        return
    enabled = not state["auto_idle_enabled"] if args.action == "toggle" else args.action == "on"
    changed = enabled != state["auto_idle_enabled"]
    state["auto_idle_enabled"] = enabled
    save_service_state(state)

    label = "enabled" if enabled else "disabled"
    suffix = f" after {state['auto_idle_seconds'] // 60} minutes" if enabled else ""
    print(f"auto-idle {label}{suffix}")


def cmd_mode(args, cfg):
    if args.mode == "cline":
        state = load_service_state()
        state.update({"mode": "cline", "pinned_model": None, "manual_unloaded": False})
        save_service_state(state)
        print("mode: cline (JIT loading and idle unload enabled)")
        return
    if not args.model:
        raise LabError("benchmark mode requires a model alias to pin")
    model_id = resolve_selector(cfg, args.model)
    require_local_model(cfg, model_id, "mode")
    state = load_service_state()
    if not api_is_ready(cfg):
        raise LabError("AI Systems Lab server is offline. Run 'make start' first.")
    switch_to_model(cfg, model_id, timeout=args.timeout)
    state.update({"mode": "benchmark", "pinned_model": model_id, "manual_unloaded": False})
    save_service_state(state)
    print(f"mode: benchmark (pinned to {model_id}; automatic switching disabled)")


def cmd_chat(args, cfg):
    model_id = resolve_selector(cfg, args.selector)
    target = model_target(cfg, model_id)
    if target.is_local:
        if not is_embedding_model(cfg, model_id):
            update_service_state(manual_unloaded=False)
        if not api_is_ready(cfg):
            if LAUNCH_AGENT_PATH.exists():
                bootstrap_service(cfg, wait=args.timeout)
            else:
                raise LabError("AI Systems Lab server is offline. Run 'make start' or 'make service-install' first.")
    result = chat_completion(
        cfg,
        model_id,
        {
        "messages": [{"role": "user", "content": args.prompt}],
        "temperature": args.temperature,
        },
        args.max_tokens,
        args.temperature,
        args.timeout,
    )
    print(json.dumps(result["response"], indent=2))


VERIFY_TOOL = {
    "type": "function",
    "function": {
        "name": "echo",
        "description": "Return the supplied value unchanged.",
        "parameters": {
            "type": "object",
            "properties": {"value": {"type": "string"}},
            "required": ["value"],
            "additionalProperties": False,
        },
    },
}


def streaming_json_events(url, payload, timeout=300):
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "text/event-stream"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            for raw_line in response:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if not data or data == "[DONE]":
                    continue
                try:
                    yield json.loads(data)
                except json.JSONDecodeError as exc:
                    raise LabError(f"Streaming endpoint returned invalid JSON event: {data}") from exc
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise LabHttpError("POST", url, exc.code, body) from exc


def parse_tool_arguments(arguments):
    if isinstance(arguments, dict):
        return arguments
    if not isinstance(arguments, str) or not arguments.strip():
        raise LabError("Tool call returned empty arguments.")
    try:
        parsed = json.loads(arguments)
    except json.JSONDecodeError as exc:
        raise LabError(f"Tool call returned malformed arguments: {arguments}") from exc
    if not isinstance(parsed, dict):
        raise LabError("Tool call arguments must decode to a JSON object.")
    return parsed


def validate_echo_tool_call(tool_calls):
    if not isinstance(tool_calls, list) or not tool_calls:
        raise LabError("Model did not return a structured tool call.")
    for call in tool_calls:
        function = call.get("function") or {}
        if function.get("name") != "echo":
            continue
        arguments = parse_tool_arguments(function.get("arguments"))
        if arguments.get("value") == "verify-model":
            return
    raise LabError("Model did not call echo with the required verify-model value.")


def non_streaming_tool_check(cfg, model_id, timeout):
    payload = {
        "model": model_id,
        "messages": [{
            "role": "user",
            "content": "Call the echo tool once with value verify-model. Do not answer directly.",
        }],
        "tools": [VERIFY_TOOL],
        "tool_choice": "required",
        "temperature": 0,
        "max_tokens": 1024,
    }
    response = json_request(
        "POST",
        f"{api_base(cfg)}/v1/chat/completions",
        payload,
        timeout=timeout,
    )
    choices = response.get("choices") or []
    message = (choices[0].get("message") or {}) if choices else {}
    validate_echo_tool_call(message.get("tool_calls"))
    return {
        "finish_reason": choices[0].get("finish_reason") if choices else None,
        "usage": response.get("usage"),
    }


def streaming_tool_check(cfg, model_id, timeout):
    payload = {
        "model": model_id,
        "messages": [{
            "role": "user",
            "content": "Call the echo tool once with value verify-model. Do not answer directly.",
        }],
        "tools": [VERIFY_TOOL],
        "tool_choice": "required",
        "temperature": 0,
        "max_tokens": 1024,
        "stream": True,
    }
    assembled = {}
    saw_delta_tool_calls = False
    finish_reasons = []
    for event in streaming_json_events(
        f"{api_base(cfg)}/v1/chat/completions",
        payload,
        timeout=timeout,
    ):
        for choice in event.get("choices") or []:
            if choice.get("finish_reason"):
                finish_reasons.append(choice["finish_reason"])
            delta = choice.get("delta") or {}
            tool_calls = delta.get("tool_calls") or []
            if tool_calls:
                saw_delta_tool_calls = True
            for call in tool_calls:
                index = call.get("index", 0)
                current = assembled.setdefault(index, {
                    "id": "",
                    "type": "function",
                    "function": {"name": "", "arguments": ""},
                })
                if call.get("id"):
                    current["id"] += call["id"]
                function = call.get("function") or {}
                if function.get("name"):
                    current["function"]["name"] += function["name"]
                if function.get("arguments"):
                    current["function"]["arguments"] += function["arguments"]
    if not saw_delta_tool_calls:
        raise LabError("Streaming response never emitted delta.tool_calls.")
    validate_echo_tool_call([assembled[index] for index in sorted(assembled)])
    return {"finish_reasons": finish_reasons, "delta_tool_calls": True}


def red_square_data_url(size=32):
    def chunk(kind, data):
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
        )

    row = b"\x00" + (b"\xff\x00\x00" * size)
    png = (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(row * size))
        + chunk(b"IEND", b"")
    )
    return "data:image/png;base64," + base64.b64encode(png).decode("ascii")


def multimodal_check(cfg, model_id, timeout):
    payload = {
        "model": model_id,
        "messages": [{
            "role": "user",
            "content": [
                {
                    "type": "text",
                    "text": "What is the dominant color of this square? Answer with one color word.",
                },
                {
                    "type": "image_url",
                    "image_url": {"url": red_square_data_url()},
                },
            ],
        }],
        "temperature": 0,
        "max_tokens": 128,
    }
    response = json_request(
        "POST",
        f"{api_base(cfg)}/v1/chat/completions",
        payload,
        timeout=timeout,
    )
    choices = response.get("choices") or []
    message = (choices[0].get("message") or {}) if choices else {}
    content = message.get("content") or ""
    if not isinstance(content, str) or "red" not in content.lower():
        raise LabError(
            "Multimodal check did not identify the red square: "
            + str(content)[:200]
        )
    return {"response": content}


def restore_model_state(cfg, previous_non_embedding, previous_manual_unloaded, timeout):
    if previous_manual_unloaded or not previous_non_embedding:
        for model_id in active_model_ids(cfg, include_embeddings=False, timeout=10):
            unload_model(cfg, model_id, quiet=True)
            wait_for_inactive(cfg, model_id, timeout=timeout)
        update_service_state(manual_unloaded=previous_manual_unloaded)
        return
    switch_to_model(cfg, previous_non_embedding[0], timeout=timeout)
    update_service_state(manual_unloaded=False)


@contextmanager
def benchmark_model_session(cfg, model_id, timeout):
    """Pin one local model for a benchmark and restore the exact prior session."""
    snapshot = copy.deepcopy(load_service_state())
    previous_non_embedding = active_model_ids(
        cfg,
        include_embeddings=False,
        timeout=10,
    )
    benchmark_state = copy.deepcopy(snapshot)
    benchmark_state.update(
        {
            "manual_unloaded": False,
            "mode": "benchmark",
            "pinned_model": model_id,
        }
    )
    restore_transition_state = copy.deepcopy(snapshot)
    restore_transition_state.update(
        {
            "manual_unloaded": False,
            "mode": "benchmark",
            "pinned_model": previous_non_embedding[0] if previous_non_embedding else None,
        }
    )
    try:
        save_service_state(benchmark_state)
        switch_to_model(cfg, model_id, timeout=timeout)
        yield
    finally:
        try:
            # Pin only the prior model while reloading it, or pin no model while
            # restoring empty residency, so switching stays excluded throughout.
            save_service_state(restore_transition_state)
            if previous_non_embedding:
                switch_to_model(cfg, previous_non_embedding[0], timeout=timeout)
            else:
                for active_model in active_model_ids(
                    cfg,
                    include_embeddings=False,
                    timeout=10,
                ):
                    unload_model(cfg, active_model, quiet=True)
                    wait_for_inactive(cfg, active_model, timeout=timeout)
        finally:
            save_service_state(snapshot)


def cmd_skill_eval(args, cfg):
    _cmd_skill_run(args, cfg, redteam=False)


def cmd_skill_redteam(args, cfg):
    _cmd_skill_run(args, cfg, redteam=True)


def _cmd_skill_run(args, cfg, redteam):
    try:
        target = skill_eval.parse_target(args.target, cfg)
        skill_eval.validate_judge(target, args.judge_model)
        dependencies = require_skill_eval_dependencies()
        if target.kind == "local":
            model_files = model_weight_paths(cfg, target.alias)
            missing = [path for path in model_files if not path.exists()]
            if missing:
                raise LabError(
                    "Local model preflight failed; missing files:\n"
                    + "\n".join(f"  {path}" for path in missing)
                )
            try:
                verify_responses_endpoint(cfg, args.timeout)
            except LabError:
                raise
            except Exception as exc:
                raise LabError(
                    f"Local server Responses preflight failed at {api_base(cfg)}/v1/responses: {exc}"
                ) from exc

        skill_dir = Path(args.skill_dir).expanduser()
        eval_dir = Path(args.eval_dir).expanduser() if args.eval_dir else None
        contract = skill_eval.load_skill_contract(skill_dir, eval_dir)
        package = skill_eval.validate_skill_package(skill_dir)
        target_digest = hashlib.sha256(
            f"{target.kind}:{target.model}".encode("utf-8")
        ).hexdigest()[:8]
        run_root = skill_eval.create_run_root(
            paths(cfg)["state_dir"] / "skill-evals",
            f"{now_stamp()}-{contract.skill_name}-{target.kind}-{target_digest}",
        )
        repetitions = 1 if redteam or args.profile == "smoke" else 5
        staged_cases = skill_eval.stage_cases(
            contract,
            package,
            repetitions,
            run_root,
            keep_workspaces_on_error=args.keep_workspaces,
        )
        config_path = run_root / "promptfooconfig.yaml"
        raw_result_path = run_root / "promptfoo.json"
        try:
            if redteam:
                redteam_builder = getattr(skill_eval, "build_redteam_config", None)
                if redteam_builder is None:
                    raise LabError(
                        "skill-redteam configuration is not installed; complete the red-team profile setup first"
                    )
                redteam_config = redteam_builder(
                    target,
                    args.judge_model,
                    staged_cases,
                    args.profile,
                )
                skill_eval._write_promptfoo_config(config_path, redteam_config)
            else:
                skill_eval.build_promptfoo_config(
                    target,
                    args.judge_model,
                    staged_cases,
                    args.profile,
                    config_path,
                )

            session = (
                benchmark_model_session(cfg, target.alias, args.timeout)
                if target.kind == "local"
                else nullcontext()
            )
            with session:
                skill_eval.run_promptfoo(
                    Path(dependencies["promptfoo"]),
                    config_path,
                    raw_result_path,
                    args.timeout,
                )
        finally:
            if not args.keep_workspaces:
                skill_eval.cleanup_staged_cases(staged_cases, run_root)
        print(raw_result_path)
    except skill_eval.SkillEvalError as exc:
        raise LabError(str(exc)) from exc


def cmd_verify(args, cfg):
    model_id = resolve_selector(cfg, args.selector)
    require_local_model(cfg, model_id, "verify")
    if is_embedding_model(cfg, model_id):
        raise LabError("verify currently exercises chat and tool calls; use it with a non-embedding model.")
    model_files = model_weight_paths(cfg, model_id)
    missing = [path for path in model_files if not path.exists()]
    if missing:
        raise LabError(
            "Model preflight failed; missing files:\n"
            + "\n".join(f"  {path}" for path in missing)
        )

    state = load_service_state()
    previous_non_embedding = []
    if api_is_ready(cfg):
        previous_non_embedding = active_model_ids(
            cfg,
            include_embeddings=False,
            timeout=10,
        )
    update_service_state(manual_unloaded=False)
    out_dir = paths(cfg)["results_dir"] / f"{now_stamp()}-verify-{model_id}"
    out_dir.mkdir(parents=True, exist_ok=True)
    checks = {
        "file_preflight": {"passed": True, "files": len(model_files)},
        "load": {"passed": False},
        "completion": {"passed": False},
        "non_streaming_tools": {"passed": False},
        "streaming_tools": {"passed": False},
        "multimodal": {"passed": True, "skipped": True},
        "residency": {"passed": False},
        "unload_or_restore": {"passed": False},
    }
    failure = None
    started = time.perf_counter()
    try:
        if not api_is_ready(cfg):
            if LAUNCH_AGENT_PATH.exists():
                bootstrap_service(cfg, wait=args.timeout)
            else:
                raise LabError(
                    "AI Systems Lab server is offline. Run 'make start' or "
                    "'make service-install' first."
                )
        load_response = switch_to_model(cfg, model_id, timeout=args.timeout)
        checks["load"] = {"passed": True, "response": load_response}

        completion = chat_completion(
            cfg,
            model_id,
            {
                "messages": [{
                    "role": "user",
                    "content": "Reply with exactly VERIFY_OK and nothing else.",
                }],
                "max_tokens": 1024,
                "temperature": 0,
            },
            1024,
            0,
            args.timeout,
        )
        if "VERIFY_OK" not in completion["text"]:
            raise LabError(
                "Completion check did not contain VERIFY_OK: "
                + completion["text"][:200]
            )
        checks["completion"] = {
            "passed": True,
            "latency_seconds": completion["latency_seconds"],
            "completion_tokens_per_second": completion["completion_tokens_per_second"],
        }

        checks["non_streaming_tools"] = {
            "passed": True,
            **non_streaming_tool_check(cfg, model_id, args.timeout),
        }
        checks["streaming_tools"] = {
            "passed": True,
            **streaming_tool_check(cfg, model_id, args.timeout),
        }
        if model_entry(cfg, model_id).get("preset", {}).get("mmproj"):
            checks["multimodal"] = {
                "passed": True,
                "skipped": False,
                **multimodal_check(cfg, model_id, args.timeout),
            }

        active = active_model_ids(cfg, include_embeddings=False, timeout=10)
        if active != [model_id]:
            raise LabError(
                f"Residency check expected only {model_id}; active models were {active}."
            )
        all_active = active_model_ids(
            cfg,
            include_embeddings=True,
            timeout=10,
        )
        checks["residency"] = {
            "passed": True,
            "non_embedding_models": active,
            "embedding_models": [
                active_model
                for active_model in all_active
                if is_embedding_model(cfg, active_model)
            ],
        }
    except Exception as exc:
        failure = str(exc)
    finally:
        try:
            if args.keep_loaded and failure is None:
                update_service_state(manual_unloaded=False)
            else:
                restore_model_state(
                    cfg,
                    previous_non_embedding,
                    state["manual_unloaded"],
                    args.timeout,
                )
            checks["unload_or_restore"] = {"passed": True}
        except Exception as restore_exc:
            checks["unload_or_restore"] = {
                "passed": False,
                "error": str(restore_exc),
            }
            if failure is None:
                failure = f"State restoration failed: {restore_exc}"

    result = {
        "schema_version": 1,
        "model": model_id,
        "passed": failure is None and all(check["passed"] for check in checks.values()),
        "elapsed_seconds": round(time.perf_counter() - started, 3),
        "checks": checks,
        "error": failure,
    }
    write_metadata(cfg, out_dir, "verify", extra={
        "model": benchmark_model_metadata(cfg, model_id),
    })
    (out_dir / "verification.json").write_text(
        json.dumps(result, indent=2) + "\n",
        encoding="utf-8",
    )
    print(json.dumps(result, indent=2))
    print(f"results: {out_dir}")
    if not result["passed"]:
        raise LabError(f"Verification failed for {model_id}: {failure}")


BENCH_FLAG_MAP = {
    "n-gpu-layers": "--n-gpu-layers",
    "n-cpu-moe": "--n-cpu-moe",
    "flash-attn": "--flash-attn",
    "batch-size": "--batch-size",
    "ubatch-size": "--ubatch-size",
    "cache-type-k": "--cache-type-k",
    "cache-type-v": "--cache-type-v",
    "threads": "--threads",
    "split-mode": "--split-mode",
    "main-gpu": "--main-gpu",
    "device": "--device",
    "mmap": "--mmap",
    "embeddings": "--embeddings",
}


def merged_preset(cfg, model_id):
    merged = dict(cfg.get("preset_defaults", {}))
    merged.update(model_entry(cfg, model_id).get("preset", {}))
    return merged


def benchmark_model_metadata(cfg, model_id):
    entry = model_entry(cfg, model_id)
    target = model_target(cfg, model_id)
    return {
        "model": model_id,
        "provider": target.provider,
        "provider_type": target.provider_type,
        "provider_model": target.model_id,
        "runtime": {
            "name": "llama.cpp" if target.is_local else target.provider_type,
            "version": runtime_version(cfg) if target.is_local else None,
        },
        "official_model_id": entry.get("official_model_id"),
        "release_date": entry.get("release_date"),
        "quantization": entry.get("quantization"),
        "context_tokens": entry.get("context_tokens"),
        "last_verified": entry.get("last_verified"),
        "license": entry.get("license"),
    }


def runtime_version(cfg):
    binary = cfg.get("server", {}).get("binary", "llama-server")
    try:
        result = subprocess.run(
            [binary, "--version"],
            text=True,
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    value = (result.stdout or result.stderr).strip()
    return value or None


def write_metadata(cfg, out_dir, command_kind, extra=None):
    meta = {
        "created_at": dt.datetime.now().isoformat(),
        "command_kind": command_kind,
        "repo": str(REPO_ROOT),
        "config": cfg["_config_path"],
        "config_hash": config_hash(cfg),
        "platform": {
            "system": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "processor": platform.processor(),
            "python": platform.python_version(),
        },
    }
    try:
        sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=str(REPO_ROOT), text=True).strip()
        meta["git_head"] = sha
    except Exception:
        pass
    if extra:
        meta.update(extra)
    (out_dir / "metadata.json").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")


def cmd_bench_llama(args, cfg):
    model_ids = selector_models(cfg, args.selector, all_candidates=args.all_candidates)
    for model_id in model_ids:
        require_local_model(cfg, model_id, "bench-llama")
    binary = cfg.get("benchmarks", {}).get("llama_bench_binary", "llama-bench")
    require_binary(binary)
    model_ids = require_model_files(cfg, model_ids, args.selector, skip_missing=args.skip_missing)
    out_dir = paths(cfg)["results_dir"] / f"{now_stamp()}-llama-bench-{args.selector}"
    out_dir.mkdir(parents=True, exist_ok=True)
    write_metadata(cfg, out_dir, "llama-bench", extra={
        "models": [benchmark_model_metadata(cfg, model_id) for model_id in model_ids],
    })

    bench_cfg = cfg.get("benchmarks", {})
    repetitions = args.repetitions or bench_cfg.get("repetitions", 3)
    n_prompt = args.n_prompt or ",".join(str(v) for v in bench_cfg.get("n_prompt", [512]))
    n_gen = args.n_gen or ",".join(str(v) for v in bench_cfg.get("n_gen", [128]))

    index_rows = []
    for model_id in model_ids:
        path = model_path(cfg, model_id)
        if not path.exists():
            raise LabError(f"Model file does not exist for {model_id}: {path}. Pull it first.")
        command = [
            binary,
            "--model", str(path),
            "--n-prompt", str(n_prompt),
            "--n-gen", str(n_gen),
            "--repetitions", str(repetitions),
            "--output", "json",
        ]
        preset = merged_preset(cfg, model_id)
        for key, flag in BENCH_FLAG_MAP.items():
            if key in preset and key not in {"load-on-startup", "stop-timeout"}:
                value = preset[key]
                if isinstance(value, bool):
                    value = "1" if value else "0"
                command.extend([flag, str(value)])

        stdout_path = out_dir / f"{model_id}.json"
        stderr_path = out_dir / f"{model_id}.stderr.log"
        cmd_path = out_dir / f"{model_id}.cmd.txt"
        cmd_path.write_text(command_to_string(command) + "\n", encoding="utf-8")
        print(f"{model_id}: {command_to_string(command)}")
        with open(stdout_path, "w", encoding="utf-8") as stdout, open(stderr_path, "w", encoding="utf-8") as stderr:
            proc = subprocess.run(command, stdout=stdout, stderr=stderr, text=True)
        index_rows.append({"model": model_id, "exit_code": proc.returncode, "stdout": str(stdout_path), "stderr": str(stderr_path)})
        if proc.returncode != 0:
            raise LabError(f"llama-bench failed for {model_id}; see {stderr_path}")

    (out_dir / "index.jsonl").write_text("".join(json.dumps(row) + "\n" for row in index_rows), encoding="utf-8")
    print(f"results: {out_dir}")


def prompt_file_for_selector(cfg, selector, override=None):
    if override:
        return repo_path(override)
    if selector in cfg.get("use_cases", {}):
        prompt_file = use_case_entry(cfg, selector).get("prompt_file")
        if prompt_file:
            return repo_path(prompt_file)
    raise LabError("No prompt file configured for selector. Pass --prompt-file.")


def read_jsonl(path):
    rows = []
    with open(path, "r", encoding="utf-8") as handle:
        for line_no, line in enumerate(handle, start=1):
            stripped = line.strip()
            if not stripped:
                continue
            try:
                rows.append(json.loads(stripped))
            except json.JSONDecodeError as exc:
                raise LabError(f"Invalid JSONL at {path}:{line_no}: {exc}") from exc
    return rows


def summarize_server_results(rows):
    grouped = {}
    for row in rows:
        if row.get("error"):
            continue
        model = row["model"]
        grouped.setdefault(model, []).append(row)

    summary = []
    for model, items in grouped.items():
        latencies = [item["latency_seconds"] for item in items]
        toks = [item["completion_tokens_per_second"] for item in items if item.get("completion_tokens_per_second")]
        memory = [
            item["model_worker_peak_rss_gib"]
            for item in items
            if item.get("model_worker_peak_rss_gib") is not None
        ]
        summary.append({
            "model": model,
            "requests": len(items),
            "avg_latency_seconds": round(sum(latencies) / len(latencies), 3) if latencies else None,
            "avg_completion_tokens_per_second": round(sum(toks) / len(toks), 3) if toks else None,
            "peak_model_worker_rss_gib": round(max(memory), 3) if memory else None,
        })
    return summary


def write_summary_csv(path, summary):
    if not summary:
        return
    with open(path, "w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(summary[0].keys()))
        writer.writeheader()
        writer.writerows(summary)


def cmd_bench_server(args, cfg):
    model_ids = selector_models(cfg, args.selector, all_candidates=args.all_candidates)
    model_ids = benchmark_models_with_local_files(
        cfg, model_ids, args.selector, args.skip_missing
    )
    prompt_path = prompt_file_for_selector(cfg, args.selector, args.prompt_file)
    prompts = read_jsonl(prompt_path)
    repetitions = args.repetitions or cfg.get("benchmarks", {}).get("server_repetitions", 2)
    out_dir = paths(cfg)["results_dir"] / f"{now_stamp()}-server-{args.selector}"
    out_dir.mkdir(parents=True, exist_ok=True)
    write_metadata(cfg, out_dir, "server", extra={
        "models": [benchmark_model_metadata(cfg, model_id) for model_id in model_ids],
    })

    result_path = out_dir / "results.jsonl"
    rows = []
    with open(result_path, "w", encoding="utf-8") as handle:
        for model_id in model_ids:
            target = model_target(cfg, model_id)

            for prompt in prompts:
                if "messages" not in prompt:
                    continue
                for rep in range(repetitions):
                    started = time.perf_counter()
                    row = {
                        "model": model_id,
                        "provider": target.provider,
                        "provider_model": target.model_id,
                        "prompt": prompt.get("name", "unnamed"),
                        "repetition": rep + 1,
                    }
                    try:
                        chat = chat_completion(
                            cfg,
                            model_id,
                            prompt,
                            prompt.get("max_tokens", args.max_tokens),
                            args.temperature,
                            args.timeout,
                        )
                        row.update({
                            "latency_seconds": chat["latency_seconds"],
                            "prompt_tokens": chat["prompt_tokens"],
                            "completion_tokens": chat["completion_tokens"],
                            "total_tokens": chat["total_tokens"],
                            "completion_tokens_per_second": chat["completion_tokens_per_second"],
                            "model_worker_peak_rss_gib": chat["model_worker_peak_rss_gib"],
                        })
                    except Exception as exc:
                        row.update({"latency_seconds": round(time.perf_counter() - started, 6), "error": str(exc)})
                    rows.append(row)
                    handle.write(json.dumps(row) + "\n")
                    handle.flush()

            if args.unload_after and target.is_local:
                unload_model(cfg, model_id, quiet=True)

    summary = summarize_server_results(rows)
    (out_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    write_summary_csv(out_dir / "summary.csv", summary)
    print(json.dumps(summary, indent=2))
    print(f"results: {out_dir}")


QUALITY_SCORE_SCHEMA = {
    "type": "object",
    "properties": {
        "correctness": {"type": "integer"},
        "completeness": {"type": "integer"},
        "instruction_following": {"type": "integer"},
        "clarity": {"type": "integer"},
        "overall": {"type": "integer"},
        "pass": {"type": "boolean"},
        "confidence": {"type": "integer"},
        "rationale": {"type": "string"},
        "strengths": {"type": "array", "items": {"type": "string"}},
        "weaknesses": {"type": "array", "items": {"type": "string"}},
        "missed_requirements": {"type": "array", "items": {"type": "string"}},
    },
    "required": [
        "correctness",
        "completeness",
        "instruction_following",
        "clarity",
        "overall",
        "pass",
        "confidence",
        "rationale",
        "strengths",
        "weaknesses",
        "missed_requirements",
    ],
    "additionalProperties": False,
}


JUDGE_INSTRUCTIONS = """You are an impartial evaluator for local LLM benchmark responses.
Score only the candidate response against the original task and rubric.
Do not reward verbosity. Penalize incorrect claims, missed constraints, unsafe code, and failure to follow output format.
Use 5 for excellent, 4 for good with minor issues, 3 for usable but meaningfully flawed, 2 for poor, and 1 for wrong or unusable.
Set pass=true only when the response is good enough to use for the stated workload without substantial human repair."""


def chat_completion(cfg, model_id, prompt, max_tokens, temperature, timeout):
    target = model_target(cfg, model_id)
    if target.is_local:
        switch_to_model(cfg, model_id, timeout=timeout)
    url, payload, headers = chat_completions_request(
        target,
        prompt["messages"],
        max_tokens,
        prompt.get("temperature", temperature),
    )
    started = time.perf_counter()
    operation = lambda: json_request("POST", url, payload, timeout=timeout, headers=headers)
    if target.is_local:
        response, model_worker_peak_rss_gib = run_with_server_memory_sample(
            cfg, operation, model_id=model_id
        )
    else:
        response = operation()
        model_worker_peak_rss_gib = None
    latency = time.perf_counter() - started
    usage = response.get("usage") or {}
    completion_tokens = usage.get("completion_tokens")
    choices = response.get("choices") or []
    message = choices[0].get("message") or {} if choices else {}
    content = message.get("content")
    if isinstance(content, str):
        output_text = content
    elif isinstance(content, list):
        output_text = "".join(
            part.get("text", "") for part in content if isinstance(part, dict)
        )
    else:
        output_text = ""
    return {
        "response": response,
        "text": output_text,
        "latency_seconds": round(latency, 6),
        "prompt_tokens": usage.get("prompt_tokens"),
        "completion_tokens": completion_tokens,
        "total_tokens": usage.get("total_tokens"),
        "completion_tokens_per_second": round(completion_tokens / latency, 6) if completion_tokens else None,
        "finish_reason": choices[0].get("finish_reason") if choices else None,
        "model_worker_peak_rss_gib": model_worker_peak_rss_gib,
        "provider": target.provider,
        "provider_model": target.model_id,
    }


def require_visible_completion(chat):
    if isinstance(chat.get("text"), str) and chat["text"].strip():
        return
    raise LabError(
        "Model returned no visible answer "
        f"(finish_reason={chat.get('finish_reason')!r}, "
        f"completion_tokens={chat.get('completion_tokens')!r})."
    )


def response_output_text(response):
    if isinstance(response.get("output_text"), str):
        return response["output_text"]
    texts = []
    for item in response.get("output", []):
        for part in item.get("content", []):
            if not isinstance(part, dict):
                continue
            if part.get("type") in {"output_text", "text"} and isinstance(part.get("text"), str):
                texts.append(part["text"])
    return "".join(texts)


def judge_config(cfg, args):
    if args.judge_base_url:
        raise LabError(
            "--judge-base-url is no longer supported; "
            "configure providers.<name>.base_url instead."
        )
    judge = cfg.get("benchmarks", {}).get("judge", {})
    provider = args.judge_provider or judge.get("provider", "manual")
    legacy_providers = {
        "local": "local-llama",
        "openai": "cloud-openai-compatible",
    }
    if provider in legacy_providers:
        replacement = legacy_providers[provider]
        print(
            f"--judge-provider {provider} is deprecated; use {replacement}.",
            file=sys.stderr,
        )
        provider = replacement
    if provider == "manual":
        return {
            "provider": "manual",
            "model": None,
            "reasoning_effort": args.judge_reasoning_effort or judge.get("reasoning_effort", "low"),
            "timeout_seconds": args.judge_timeout or judge.get("timeout_seconds", 120),
        }
    if provider not in cfg.get("providers", {}):
        raise LabError(f"Unknown judge provider '{provider}'.")
    model_id = args.judge_model or judge.get("model")
    if not model_id:
        raise LabError(f"--judge-model is required when --judge-provider {provider}.")
    model_id = resolve_selector(cfg, model_id)
    try:
        target = model_target(cfg, model_id)
    except ProviderConfigError as exc:
        raise LabError(str(exc)) from exc
    if target.provider != provider:
        raise LabError(
            f"Judge model '{model_id}' does not belong to judge provider '{provider}'."
        )
    return {
        "provider": provider,
        "model": model_id,
        "reasoning_effort": args.judge_reasoning_effort or judge.get("reasoning_effort", "low"),
        "timeout_seconds": args.judge_timeout or judge.get("timeout_seconds", 120),
        "target": target,
    }


def validate_quality_score(score):
    for key in ["correctness", "completeness", "instruction_following", "clarity", "overall", "confidence"]:
        value = score.get(key)
        if not isinstance(value, int) or value < 1 or value > 5:
            raise LabError(f"Judge returned invalid {key} score: {value!r}")
    if not isinstance(score.get("pass"), bool):
        raise LabError("Judge returned invalid pass value.")
    for key in ["strengths", "weaknesses", "missed_requirements"]:
        if not isinstance(score.get(key), list):
            raise LabError(f"Judge returned invalid {key} list.")


def openai_score_response(target, judge_cfg, eval_payload):
    url, payload, headers = responses_json_request(
        target,
        JUDGE_INSTRUCTIONS,
        json.dumps(eval_payload, ensure_ascii=False, indent=2),
        QUALITY_SCORE_SCHEMA,
        judge_cfg.get("reasoning_effort"),
    )
    started = time.perf_counter()
    response = json_request(
        "POST",
        url,
        payload,
        timeout=judge_cfg["timeout_seconds"],
        headers=headers,
    )
    latency = time.perf_counter() - started
    raw_text = response_output_text(response)
    if not raw_text:
        raise LabError("Remote judge returned no output text.")
    try:
        score = json.loads(raw_text)
    except json.JSONDecodeError as exc:
        raise LabError(f"Remote judge returned invalid JSON: {raw_text}") from exc
    validate_quality_score(score)
    return {
        "score": score,
        "judge_latency_seconds": round(latency, 6),
        "judge_response_id": response.get("id"),
        "judge_usage": response.get("usage"),
    }


def extract_json_object(text):
    stripped = text.strip()
    if stripped.startswith("```"):
        stripped = re.sub(r"^```(?:json)?\s*", "", stripped)
        stripped = re.sub(r"\s*```$", "", stripped)
    try:
        parsed = json.loads(stripped)
    except json.JSONDecodeError:
        start = stripped.find("{")
        end = stripped.rfind("}")
        if start < 0 or end <= start:
            raise LabError(f"Local judge returned invalid JSON: {text[:500]}")
        try:
            parsed = json.loads(stripped[start:end + 1])
        except json.JSONDecodeError as exc:
            raise LabError(f"Local judge returned invalid JSON: {text[:500]}") from exc
    if not isinstance(parsed, dict):
        raise LabError("Local judge returned JSON that was not an object.")
    return parsed


def local_score_response(cfg, judge_cfg, eval_payload):
    model_id = judge_cfg.get("model")
    prompt = {
        "messages": [
            {"role": "system", "content": JUDGE_INSTRUCTIONS},
            {
                "role": "user",
                "content": (
                    "Return only a JSON object matching this JSON Schema:\n"
                    + json.dumps(QUALITY_SCORE_SCHEMA, ensure_ascii=False)
                    + "\n\nEvaluation input:\n"
                    + json.dumps(eval_payload, ensure_ascii=False, indent=2)
                ),
            },
        ],
        "max_tokens": 1024,
        "temperature": 0,
    }
    result = chat_completion(
        cfg,
        model_id,
        prompt,
        1024,
        0,
        judge_cfg["timeout_seconds"],
    )
    score = extract_json_object(result["text"])
    validate_quality_score(score)
    return {
        "score": score,
        "judge_latency_seconds": result["latency_seconds"],
        "judge_response_id": None,
        "judge_usage": {
            "prompt_tokens": result["prompt_tokens"],
            "completion_tokens": result["completion_tokens"],
            "total_tokens": result["total_tokens"],
        },
    }


def score_quality_response(cfg, judge_cfg, eval_payload):
    if judge_cfg["provider"] == "manual":
        return {}
    target = judge_cfg["target"]
    if target.is_local:
        return local_score_response(cfg, judge_cfg, eval_payload)
    return openai_score_response(target, judge_cfg, eval_payload)


def quality_eval_payload(selector, model_id, prompt, candidate_text):
    return {
        "use_case": selector,
        "prompt_name": prompt.get("name", "unnamed"),
        "task_messages": prompt.get("messages", []),
        "rubric": prompt.get("quality_rubric", ""),
        "expected": prompt.get("expected", ""),
        "must_include": prompt.get("must_include", []),
        "candidate_model": model_id,
        "candidate_response": candidate_text,
    }


def summarize_quality_results(rows):
    grouped = {}
    for row in rows:
        if row.get("error"):
            continue
        grouped.setdefault(row["model"], []).append(row)

    summary = []
    for model, items in grouped.items():
        judged = [item for item in items if item.get("score")]

        def avg_score(name):
            values = [item["score"][name] for item in judged if name in item["score"]]
            return round(sum(values) / len(values), 3) if values else None

        latencies = [item["latency_seconds"] for item in items if item.get("latency_seconds") is not None]
        toks = [item["completion_tokens_per_second"] for item in items if item.get("completion_tokens_per_second")]
        memory = [
            item["model_worker_peak_rss_gib"]
            for item in items
            if item.get("model_worker_peak_rss_gib") is not None
        ]
        passes = [1 if item["score"].get("pass") else 0 for item in judged]
        summary.append({
            "model": model,
            "responses": len(items),
            "judged": len(judged),
            "avg_overall": avg_score("overall"),
            "avg_correctness": avg_score("correctness"),
            "avg_completeness": avg_score("completeness"),
            "avg_instruction_following": avg_score("instruction_following"),
            "pass_rate": round(sum(passes) / len(passes), 3) if passes else None,
            "avg_latency_seconds": round(sum(latencies) / len(latencies), 3) if latencies else None,
            "avg_completion_tokens_per_second": round(sum(toks) / len(toks), 3) if toks else None,
            "peak_model_worker_rss_gib": round(max(memory), 3) if memory else None,
        })
    return sorted(summary, key=lambda item: (item.get("avg_overall") or 0, item.get("pass_rate") or 0), reverse=True)


def cmd_bench_quality(args, cfg):
    model_ids = selector_models(cfg, args.selector, all_candidates=args.all_candidates)
    model_ids = benchmark_models_with_local_files(
        cfg, model_ids, args.selector, args.skip_missing
    )
    prompt_path = prompt_file_for_selector(cfg, args.selector, args.prompt_file)
    prompts = [prompt for prompt in read_jsonl(prompt_path) if "messages" in prompt]
    if args.limit_prompts:
        prompts = prompts[:args.limit_prompts]
    if not prompts:
        raise LabError(f"No chat prompts found in {prompt_path}")

    judge_cfg = judge_config(cfg, args)
    judge_target = judge_cfg.get("target")
    if judge_target and judge_target.is_local:
        require_local_model(cfg, judge_cfg["model"], "local judge")
        if judge_cfg["model"] in model_ids:
            raise LabError("The local judge model must be different from every candidate model.")
    repetitions = args.repetitions or cfg.get("benchmarks", {}).get("quality_repetitions", 1)
    out_dir = paths(cfg)["results_dir"] / f"{now_stamp()}-quality-{args.selector}"
    out_dir.mkdir(parents=True, exist_ok=True)
    judge_metadata = {"provider": judge_cfg["provider"]}
    if judge_cfg["provider"] != "manual":
        judge_metadata.update({
            key: value
            for key, value in judge_cfg.items()
            if key not in {"provider", "api_key", "target"}
        })
    write_metadata(cfg, out_dir, "quality", extra={
        "judge": judge_metadata,
        "prompt_file": str(prompt_path),
        "models": [benchmark_model_metadata(cfg, model_id) for model_id in model_ids],
        "repetitions": repetitions,
    })

    rows = []
    manual_reviews = []
    result_path = out_dir / "results.jsonl"
    with open(result_path, "w", encoding="utf-8") as handle:
        for model_id in model_ids:
            target = model_target(cfg, model_id)
            for prompt in prompts:
                for rep in range(repetitions):
                    row = {
                        "model": model_id,
                        "provider": target.provider,
                        "provider_model": target.model_id,
                        "prompt": prompt.get("name", "unnamed"),
                        "repetition": rep + 1,
                    }
                    try:
                        chat = chat_completion(
                            cfg,
                            model_id,
                            prompt,
                            args.max_tokens,
                            args.temperature,
                            args.timeout,
                        )
                        row.update({
                            "latency_seconds": chat["latency_seconds"],
                            "prompt_tokens": chat["prompt_tokens"],
                            "completion_tokens": chat["completion_tokens"],
                            "total_tokens": chat["total_tokens"],
                            "completion_tokens_per_second": chat["completion_tokens_per_second"],
                            "model_worker_peak_rss_gib": chat["model_worker_peak_rss_gib"],
                            "finish_reason": chat["finish_reason"],
                            "answer": chat["text"],
                        })
                        require_visible_completion(chat)
                    except Exception as exc:
                        row["error"] = str(exc)
                        rows.append(row)
                        handle.write(json.dumps(row, ensure_ascii=False) + "\n")
                        handle.flush()
                        print(
                            f"{model_id}/{row['prompt']} rep={rep + 1}: "
                            f"failed: {exc}",
                            flush=True,
                        )
                        continue
                    eval_payload = quality_eval_payload(
                        args.selector,
                        model_id,
                        prompt,
                        chat["text"],
                    )
                    if judge_cfg["provider"] == "manual":
                        manual_reviews.append({
                            "model": model_id,
                            "prompt": row["prompt"],
                            "repetition": rep + 1,
                            "evaluation": eval_payload,
                            "score": {
                                "correctness": None,
                                "completeness": None,
                                "instruction_following": None,
                                "clarity": None,
                                "overall": None,
                                "pass": None,
                                "confidence": None,
                                "rationale": "",
                                "strengths": [],
                                "weaknesses": [],
                                "missed_requirements": [],
                            },
                        })
                    else:
                        try:
                            row.update(score_quality_response(cfg, judge_cfg, eval_payload))
                        except Exception as exc:
                            row["judge_error"] = str(exc)
                            rows.append(row)
                            handle.write(json.dumps(row, ensure_ascii=False) + "\n")
                            handle.flush()
                            raise
                    rows.append(row)
                    handle.write(json.dumps(row, ensure_ascii=False) + "\n")
                    handle.flush()
                    if row.get("score"):
                        print(
                            f"{model_id}/{row['prompt']} rep={rep + 1}: "
                            f"overall={row['score']['overall']} pass={row['score']['pass']}",
                            flush=True,
                        )
                    else:
                        print(
                            f"{model_id}/{row['prompt']} rep={rep + 1}: "
                            "awaiting manual review",
                            flush=True,
                        )

            if judge_target and judge_target.is_local:
                if args.unload_after:
                    unload_model(cfg, judge_cfg["model"], quiet=True)
                elif target.is_local:
                    switch_to_model(cfg, model_id, timeout=args.timeout)
            elif args.unload_after and target.is_local:
                unload_model(cfg, model_id, quiet=True)

    summary = summarize_quality_results(rows)
    if manual_reviews:
        (out_dir / "manual-review.json").write_text(
            json.dumps(manual_reviews, indent=2, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
    (out_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    write_summary_csv(out_dir / "summary.csv", summary)
    print(json.dumps(summary, indent=2))
    print(f"results: {out_dir}")


PUBLIC_DROP_KEYS = {
    "answer",
    "api_key",
    "candidate_response",
    "command",
    "config",
    "config_hash",
    "environment",
    "evaluation",
    "git_head",
    "headers",
    "hostname",
    "judge_response_id",
    "missed_requirements",
    "processor",
    "platform",
    "rationale",
    "repo",
    "stderr",
    "stdout",
    "strengths",
    "task_messages",
    "weaknesses",
}


def sanitize_public_string(value):
    sanitized = redact_secrets(value)
    home = str(Path.home())
    replacements = {
        home: "${HOME}",
        str(REPO_ROOT): "${REPO}",
    }
    for private_value, replacement in replacements.items():
        sanitized = sanitized.replace(private_value, replacement)
    sanitized = re.sub(r"/Users/[^/\s\"']+", "${HOME}", sanitized)
    sanitized = re.sub(r"/home/[^/\s\"']+", "${HOME}", sanitized)
    sanitized = re.sub(
        r"(?i)(authorization\s*:\s*bearer\s+)[^\s\"']+",
        r"\1REDACTED",
        sanitized,
    )
    sanitized = re.sub(
        r"(?i)(api[_-]?key|token|secret)([\"']?\s*[:=]\s*[\"']?)[^,\s\"']+",
        r"\1\2REDACTED",
        sanitized,
    )
    return sanitized


def sanitize_public_value(value, key=None):
    normalized_key = key.lower() if isinstance(key, str) else ""
    if (
        normalized_key in PUBLIC_DROP_KEYS
        or normalized_key.endswith("_path")
        or normalized_key.endswith("_file")
        or normalized_key.endswith("_command")
    ):
        return None
    if isinstance(value, dict):
        result = {}
        for child_key, child_value in value.items():
            sanitized = sanitize_public_value(child_value, child_key)
            if sanitized is not None:
                result[child_key] = sanitized
        return result
    if isinstance(value, list):
        return [
            sanitized
            for item in value
            if (sanitized := sanitize_public_value(item, key)) is not None
        ]
    if isinstance(value, str):
        return sanitize_public_string(value)
    return value


def load_public_source_file(path):
    if path.suffix == ".json":
        return json.loads(path.read_text(encoding="utf-8"))
    if path.suffix == ".jsonl":
        return read_jsonl(path)
    if path.suffix == ".csv":
        with open(path, "r", encoding="utf-8", newline="") as handle:
            return list(csv.DictReader(handle))
    raise LabError(f"Unsupported public export source file: {path}")


def validate_public_export(payload):
    serialized = json.dumps(payload, ensure_ascii=False)
    forbidden = [
        (r"/Users/[^/\s\"']+", "private user path"),
        (r"sk-[A-Za-z0-9_*.-]{8,}", "API key"),
        (r"(?i)authorization\s*:\s*bearer\s+(?!REDACTED)", "bearer token"),
        (r"(?i)BEGIN (?:RSA |OPENSSH )?PRIVATE KEY", "private key"),
    ]
    for pattern, label in forbidden:
        if re.search(pattern, serialized):
            raise LabError(f"Public export still contains a {label}.")


def cmd_export_public(args, cfg):
    result_dir = Path(args.result_dir).expanduser().resolve()
    if not result_dir.is_dir():
        raise LabError(f"Result directory does not exist: {result_dir}")
    output_path = Path(args.output).expanduser().resolve()
    included = {}
    for name in [
        "metadata.json",
        "summary.json",
        "summary.csv",
        "verification.json",
        "results.jsonl",
        "index.jsonl",
    ]:
        source = result_dir / name
        if source.exists():
            included[name] = sanitize_public_value(load_public_source_file(source))
    if not included:
        raise LabError(f"No supported benchmark artifacts found in {result_dir}")
    payload = {
        "schema_version": 1,
        "exported_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "result_type": (included.get("metadata.json") or {}).get("command_kind"),
        "artifacts": included,
    }
    validate_public_export(payload)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(
        json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    print(output_path)


def build_parser():
    parser = argparse.ArgumentParser(description="AI Systems Lab llama.cpp orchestration.")
    parser.add_argument("--config", default=project_env("CONFIG") or str(DEFAULT_CONFIG))
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor")
    sub.add_parser("models-config")
    sub.add_parser("presets")

    catalog = sub.add_parser("catalog")
    catalog.add_argument("--role")
    catalog.add_argument("--status", choices=["core", "candidate", "retired", "watch"])
    catalog.add_argument("--format", choices=["text", "json"], default="text")

    pull = sub.add_parser("pull")
    pull.add_argument("selector", help="model alias or use case")
    pull.add_argument("--all-candidates", action="store_true", help="when selector is a use case, pull all candidate models")
    pull.add_argument("--dry-run", action="store_true")
    pull.add_argument("--force", action="store_true")

    start = sub.add_parser("start")
    start.add_argument("--wait", type=int, default=30)
    start.add_argument("--skip-model-check", action="store_true")

    sub.add_parser("serve", help="run llama-server in the foreground for service supervision")

    stop = sub.add_parser("stop")
    stop.add_argument("--wait", type=int, default=10)
    stop.add_argument("--force", action="store_true")

    status = sub.add_parser("status")
    status.add_argument("--format", choices=["text", "raycast", "json"], default="text")

    service_install = sub.add_parser("service-install")
    service_install.add_argument("--wait", type=int, default=15, help="seconds to stop an existing lab server")
    service_install.add_argument("--startup-wait", type=int, default=180)
    service_install.add_argument("--force", action="store_true")

    service_start = sub.add_parser("service-start")
    service_start.add_argument("--wait", type=int, default=180)

    service_stop = sub.add_parser("service-stop")
    service_stop.add_argument("--wait", type=int, default=15)

    service_restart = sub.add_parser("service-restart")
    service_restart.add_argument("--wait", type=int, default=180)

    service_status = sub.add_parser("service-status")
    service_status.add_argument("--format", choices=["text", "raycast", "json"], default="text")

    sub.add_parser("service-uninstall")
    sub.add_parser("service-uninstall-legacy")

    auto_idle = sub.add_parser("auto-idle")
    auto_idle.add_argument("action", choices=["on", "off", "toggle", "status"])
    auto_idle.add_argument("--wait", type=int, default=180)

    mode = sub.add_parser("mode", help="select Cline JIT or reproducible benchmark residency")
    mode.add_argument("mode", choices=["cline", "benchmark"])
    mode.add_argument("model", nargs="?")
    mode.add_argument("--timeout", type=int, default=900)

    logs = sub.add_parser("logs")
    logs.add_argument("--lines", type=int, default=120)

    sub.add_parser("list")

    load = sub.add_parser("load")
    load.add_argument("selector")
    load.add_argument("--timeout", type=int, default=900)

    switch = sub.add_parser("switch")
    switch.add_argument("selector")
    switch.add_argument("--timeout", type=int, default=900)

    unload = sub.add_parser("unload")
    unload.add_argument("selector")

    unload_active = sub.add_parser("unload-active")
    unload_active.add_argument("--timeout", type=int, default=300)

    chat = sub.add_parser("chat")
    chat.add_argument("selector")
    chat.add_argument("prompt")
    chat.add_argument("--max-tokens", type=int, default=512)
    chat.add_argument("--temperature", type=float, default=0.2)
    chat.add_argument("--timeout", type=int, default=900)

    verify = sub.add_parser("verify")
    verify.add_argument("selector")
    verify.add_argument("--timeout", type=int, default=900)
    verify.add_argument("--keep-loaded", action="store_true")

    bench_llama = sub.add_parser("bench-llama")
    bench_llama.add_argument("selector")
    bench_llama.add_argument("--all-candidates", action="store_true")
    bench_llama.add_argument("--repetitions", type=int)
    bench_llama.add_argument("--n-prompt")
    bench_llama.add_argument("--n-gen")
    bench_llama.add_argument("--skip-missing", action="store_true")

    bench_server = sub.add_parser("bench-server")
    bench_server.add_argument("selector")
    bench_server.add_argument("--all-candidates", action="store_true")
    bench_server.add_argument("--prompt-file")
    bench_server.add_argument("--repetitions", type=int)
    bench_server.add_argument("--max-tokens", type=int, default=384)
    bench_server.add_argument("--temperature", type=float, default=0.2)
    bench_server.add_argument("--timeout", type=int, default=900)
    bench_server.add_argument("--unload-after", action="store_true")
    bench_server.add_argument("--skip-missing", action="store_true")

    bench_quality = sub.add_parser("bench-quality")
    bench_quality.add_argument("selector")
    bench_quality.add_argument("--all-candidates", action="store_true")
    bench_quality.add_argument("--prompt-file")
    bench_quality.add_argument("--repetitions", type=int)
    bench_quality.add_argument("--limit-prompts", type=int)
    bench_quality.add_argument("--max-tokens", type=int, default=4096)
    bench_quality.add_argument("--temperature", type=float, default=0.2)
    bench_quality.add_argument("--timeout", type=int, default=900)
    bench_quality.add_argument("--unload-after", action="store_true")
    bench_quality.add_argument("--skip-missing", action="store_true")
    bench_quality.add_argument(
        "--judge-provider",
        default=None,
    )
    bench_quality.add_argument("--judge-base-url", default=None)
    bench_quality.add_argument("--judge-model", default=None)
    bench_quality.add_argument("--judge-reasoning-effort", default=None)
    bench_quality.add_argument("--judge-timeout", type=int, default=None)

    export_public = sub.add_parser("export-public")
    export_public.add_argument("result_dir")
    export_public.add_argument("--output", required=True)

    skill_eval_parser = sub.add_parser("skill-eval")
    skill_eval_parser.add_argument("skill_dir")
    skill_eval_parser.add_argument("--target", required=True)
    skill_eval_parser.add_argument("--judge-model", required=True)
    skill_eval_parser.add_argument("--eval-dir")
    skill_eval_parser.add_argument("--profile", choices=["smoke", "release"], default="smoke")
    skill_eval_parser.add_argument("--timeout", type=int, default=900)
    skill_eval_parser.add_argument("--keep-workspaces", action="store_true")

    skill_redteam_parser = sub.add_parser("skill-redteam")
    skill_redteam_parser.add_argument("skill_dir")
    skill_redteam_parser.add_argument("--target", required=True)
    skill_redteam_parser.add_argument("--judge-model", required=True)
    skill_redteam_parser.add_argument("--eval-dir")
    skill_redteam_parser.add_argument("--profile", choices=["core", "deep"], default="core")
    skill_redteam_parser.add_argument("--timeout", type=int, default=900)
    skill_redteam_parser.add_argument("--keep-workspaces", action="store_true")

    return parser


COMMANDS = {
    "doctor": cmd_doctor,
    "models-config": cmd_models_config,
    "catalog": cmd_catalog,
    "pull": cmd_pull,
    "presets": cmd_presets,
    "start": cmd_start,
    "serve": cmd_serve,
    "stop": cmd_stop,
    "status": cmd_status,
    "service-install": cmd_service_install,
    "service-start": cmd_service_start,
    "service-stop": cmd_service_stop,
    "service-restart": cmd_service_restart,
    "service-status": cmd_status,
    "service-uninstall": cmd_service_uninstall,
    "service-uninstall-legacy": cmd_service_uninstall_legacy,
    "auto-idle": cmd_auto_idle,
    "mode": cmd_mode,
    "logs": cmd_logs,
    "list": cmd_list,
    "load": cmd_load,
    "switch": cmd_switch,
    "unload": cmd_unload,
    "unload-active": cmd_unload_active,
    "chat": cmd_chat,
    "verify": cmd_verify,
    "bench-llama": cmd_bench_llama,
    "bench-server": cmd_bench_server,
    "bench-quality": cmd_bench_quality,
    "skill-eval": cmd_skill_eval,
    "skill-redteam": cmd_skill_redteam,
    "export-public": cmd_export_public,
}


def main():
    parser = build_parser()
    args = parser.parse_args()
    cfg = load_config(args.config)
    try:
        COMMANDS[args.command](args, cfg)
    except KeyboardInterrupt:
        raise
    except subprocess.CalledProcessError as exc:
        print(f"command failed with exit {exc.returncode}: {command_to_string(exc.cmd)}", file=sys.stderr)
        return exc.returncode
    except (LabError, ProviderConfigError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
