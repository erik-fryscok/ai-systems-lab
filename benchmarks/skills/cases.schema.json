{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-lab.dev/schemas/skill-eval-cases-v1.json",
  "title": "Local AI Lab Skill Evaluation Cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "prompt", "fixture", "sandbox", "expected", "rubric"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["direct_activation", "implicit_activation", "negative_activation"]},
        "prompt": {"type": "string", "minLength": 1},
        "fixture": {"type": "string", "minLength": 1},
        "sandbox": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
        "expected": {"$ref": "#/$defs/expected"},
        "rubric": {"type": "string", "minLength": 1}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_used", "output", "files", "forbidden"],
      "properties": {
        "skill_used": {"type": "boolean"},
        "output": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": {"enum": ["contains", "not-contains", "equals", "not-equals", "regex", "not-regex", "starts-with"]},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unchanged", "created"],
          "properties": {
            "unchanged": {"$ref": "#/$defs/string-list"},
            "created": {"$ref": "#/$defs/string-list"}
          }
        },
        "forbidden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command_patterns", "path_patterns", "network"],
          "properties": {
            "command_patterns": {"$ref": "#/$defs/string-list"},
            "path_patterns": {"$ref": "#/$defs/string-list"},
            "network": {"type": "boolean"}
          }
        }
      }
    },
    "string-list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
