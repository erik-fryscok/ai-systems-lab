{
  "providers": {
    "local-llama": {
      "type": "llama_cpp",
      "responses_api": true
    }
  },
  "paths": {
    "models_dir": "~/Models/ai-systems-lab",
    "state_dir": ".ai-systems-lab",
    "generated_dir": "config/generated",
    "results_dir": "benchmarks/results"
  },
  "fleet": {
    "installed_weight_cap_gib": 400,
    "primary_runtime": "llama.cpp",
    "default_large_context_tokens": 32768,
    "admission_agents": ["cline", "opencode"],
    "additional_agents": ["qwen-code", "aider"]
  },
  "server": {
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 8080,
    "backend_port": 8081,
    "models_max": null,
    "models_autoload": false,
    "metrics": true,
    "sleep_idle_seconds": null,
    "load_timeout_seconds": 900,
    "request_timeout_seconds": 1800,
    "extra_args": ["--jinja"]
  },
  "preset_defaults": {
    "ctx-size": 8192,
    "n-gpu-layers": 999,
    "flash-attn": "auto",
    "batch-size": 2048,
    "ubatch-size": 512,
    "mmap": true
  },
  "benchmarks": {
    "llama_bench_binary": "llama-bench",
    "repetitions": 3,
    "n_prompt": [512, 2048],
    "n_gen": [128, 512],
    "server_repetitions": 2,
    "quality_repetitions": 1,
    "judge": {
      "provider": "manual",
      "model": null,
      "reasoning_effort": "low",
      "timeout_seconds": 120
    }
  },
  "use_cases": {
    "coder": {
      "default_model": "qwen3.6-35b-a3b",
      "candidate_models": [
        "qwen3.6-35b-a3b",
        "devstral-small-2-24b",
        "reason-27b"
      ],
      "prompt_file": "benchmarks/prompts/coder.jsonl"
    },
    "reason": {
      "default_model": "reason-27b",
      "candidate_models": [
        "reason-27b",
        "gpt-oss-20b",
        "gpt-oss-120b",
        "qwen3.5-122b-a10b"
      ],
      "prompt_file": "benchmarks/prompts/reason.jsonl"
    },
    "review": {
      "default_model": "gpt-oss-120b",
      "candidate_models": [
        "gpt-oss-120b",
        "qwen3.5-122b-a10b",
        "reason-27b"
      ],
      "prompt_file": "benchmarks/prompts/reason.jsonl"
    },
    "fast": {
      "default_model": "fast-9b",
      "candidate_models": ["fast-9b", "gpt-oss-20b"],
      "prompt_file": "benchmarks/prompts/fast.jsonl"
    },
    "vision": {
      "default_model": "gemma-4-12b",
      "candidate_models": ["gemma-4-12b"],
      "prompt_file": "benchmarks/prompts/fast.jsonl"
    },
    "embedding": {
      "default_model": "embed-4b",
      "candidate_models": ["embed-4b"],
      "prompt_file": "benchmarks/prompts/embedding.jsonl"
    }
  },
